#!/bin/sh
# Antigravity CLI's built-in ACP server (antigravity-cli >= 1.5).
# Prefer mise's installed binary directly (no shim auto-update noise on stdio);
# fall back to the mise shim if not yet materialized.
agy="$HOME/.local/share/mise/installs/antigravity-cli/latest/agy"
[ -x "$agy" ] || agy="$HOME/.local/share/mise/shims/agy"
exec "$HOME/.local/lib/buzz-host/bin/acp-proxy" "$agy" acp --dangerously-skip-permissions
