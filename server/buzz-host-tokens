#!/usr/bin/env node
// Compatibility shim: `buzz-host-tokens <cmd>` is `buzz-host tokens <cmd>`.
// The commands live in tokens-cli.mjs (next to this file in a checkout, one
// directory up once deployed to <lib>/bin). See `buzz-host tokens --help`.

import { existsSync } from "node:fs";

const modPath = existsSync(new URL("./tokens-cli.mjs", import.meta.url)) ? "./tokens-cli.mjs" : "../tokens-cli.mjs";
const { runTokens } = await import(modPath);
process.exitCode = await runTokens(process.argv.slice(2), { prog: "buzz-host-tokens" });
