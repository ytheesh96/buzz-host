#!/usr/sbin/nft -f
# Egress filter for buzz-host sandboxed agents (Docker network "buzz-sandbox",
# bridge buzzsbx0). Containers keep public internet access (model proxy runs
# over a unix socket; the relay is reached through its public Funnel name) but
# cannot reach this host, the LAN, the tailnet, or each other.
#
# Lives in its own table so Docker's own iptables/nftables rules never touch
# it. A drop in any base chain is final, so ordering against Docker's chains
# doesn't matter.

table inet buzz_sandbox
delete table inet buzz_sandbox

table inet buzz_sandbox {
	set blocked4 {
		type ipv4_addr
		flags interval
		elements = {
			0.0.0.0/8,        # "this" network
			10.0.0.0/8,       # RFC1918
			100.64.0.0/10,    # CGNAT, incl. Tailscale 100.x and MagicDNS 100.100.100.100
			127.0.0.0/8,      # loopback
			169.254.0.0/16,   # link-local / cloud metadata
			172.16.0.0/12,    # RFC1918 (incl. other Docker networks and sandbox peers)
			192.0.0.0/24,     # IETF protocol assignments
			192.168.0.0/16,   # RFC1918 (home LAN)
			198.18.0.0/15,    # benchmarking
			224.0.0.0/4,      # multicast
			240.0.0.0/4       # reserved + broadcast
		}
	}

	# Anything addressed to this host itself (any of its IPs: LAN, tailnet,
	# bridge gateways) arrives on input, not forward.
	chain input {
		type filter hook input priority filter - 10; policy accept;
		iifname "buzzsbx0" counter drop
	}

	chain forward {
		type filter hook forward priority filter - 10; policy accept;
		iifname "buzzsbx0" ip daddr @blocked4 counter drop
		iifname "buzzsbx0" meta nfproto ipv6 counter drop
		# Bridged container-to-container traffic (br_netfilter) on the same bridge.
		iifname "buzzsbx0" oifname "buzzsbx0" counter drop
	}
}
