#!/bin/bash
# Runs one sandboxed buzz-host agent inside a hardened Docker container.
# Invoked by server/agent-run when BUZZ_HOST_RUNNER=docker.
set -euo pipefail

pubkey="$1"
[[ "$pubkey" =~ ^[0-9a-f]{64}$ ]] || { echo "bad pubkey" >&2; exit 78; }

agent_dir="$HOME/.local/share/buzz-host/agents/$pubkey"
lib_dir="${BUZZ_HOST_LIB:-$HOME/.local/lib/buzz-host}"
# The agent's /workspace: its own ~/buzz-agents/<pubkey>, or (a guest's
# owner-only agents, chosen by buzz-host in runtime.env) the guest's shared
# ~/buzz-sandboxes/<tokenId>. Nothing else may be mounted there.
default_work_dir="$HOME/buzz-agents/$pubkey"
work_dir="${BUZZ_SANDBOX_WORKSPACE_DIR:-$default_work_dir}"
if [[ "$work_dir" != "$default_work_dir" ]] && ! [[ "$work_dir" =~ ^"$HOME"/buzz-sandboxes/tok_[0-9a-f]{12}$ ]]; then
  echo "BUZZ_SANDBOX_WORKSPACE_DIR must be $default_work_dir or $HOME/buzz-sandboxes/tok_<12 hex> (got '$work_dir')" >&2
  exit 78
fi
if [[ "$work_dir" != "$default_work_dir" ]]; then
  for p in "$work_dir" "$(dirname "$work_dir")"; do
    if [[ -L "$p" ]]; then echo "refusing to mount a symlinked shared workspace ($p)" >&2; exit 78; fi
  done
fi
run_root="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/buzz-host"
prefix="${pubkey:0:16}"
sandbox_run="$run_root/sandbox/$prefix"
control_dir="$run_root/${prefix}.d"
image="${BUZZ_SANDBOX_IMAGE:-buzz-host-sandbox:latest}"
memory="${BUZZ_SANDBOX_MEMORY:-1536m}"
cpus="${BUZZ_SANDBOX_CPUS:-2}"
pids_limit="${BUZZ_SANDBOX_PIDS_LIMIT:-256}"
cname="buzz-agent-${prefix}"
network="${BUZZ_SANDBOX_NETWORK:-buzz-sandbox}"
firewall_unit="buzz-sandbox-firewall.service"

[[ -f "$agent_dir/sandbox.env" ]] || { echo "sandbox.env missing (re-activate or restart buzz-host)" >&2; exit 78; }
[[ -S "$sandbox_run/proxy.sock" ]] || { echo "sandbox proxy socket missing ($sandbox_run/proxy.sock); is buzz-host running?" >&2; exit 75; }

# Fail closed: the egress filter (root nftables table, see install-firewall.sh)
# is what keeps the container off this host, the LAN and the tailnet.
if ! systemctl is-active --quiet "$firewall_unit"; then
  echo "$firewall_unit is not active; refusing to start a sandboxed agent without the egress filter (run: sudo server/sandbox/install-firewall.sh)" >&2
  exit 78
fi

# Dedicated bridge whose name the filter matches; no inter-container traffic.
if ! docker network inspect "$network" >/dev/null 2>&1; then
  docker network create --driver bridge \
    --subnet "${BUZZ_SANDBOX_SUBNET:-172.30.0.0/24}" \
    -o com.docker.network.bridge.name=buzzsbx0 \
    -o com.docker.network.bridge.enable_icc=false \
    "$network" >/dev/null 2>&1 || docker network inspect "$network" >/dev/null
fi
bridge="$(docker network inspect -f '{{index .Options "com.docker.network.bridge.name"}}' "$network")"
[[ "$bridge" == "buzzsbx0" ]] || { echo "docker network $network must use bridge buzzsbx0 (got '$bridge')" >&2; exit 78; }

mkdir -p -m 700 "$control_dir" "$agent_dir/fresh" "$agent_dir/wake/results" "$agent_dir/sandbox-home" "$sandbox_run/agent"
if [[ "$work_dir" == "$default_work_dir" ]]; then
  mkdir -p "$work_dir"
else
  mkdir -p -m 700 "$(dirname "$work_dir")" "$work_dir"
fi

# Clean up any leftover container from an abrupt crash.
docker rm -f "$cname" >/dev/null 2>&1 || true

# Forward SIGTERM/SIGINT from systemd to graceful container stop.
cleanup() {
  docker stop -t 10 "$cname" >/dev/null 2>&1 || true
}
trap cleanup TERM INT

args=(
  run --rm --init
  --name "$cname"
  --user "$(id -u):$(id -g)"
  --cap-drop=ALL
  --security-opt=no-new-privileges:true
  --read-only
  --network "$network"
  --dns 1.1.1.1
  --dns 8.8.8.8
  --dns-search .
  "--pids-limit=${pids_limit}"
  "--memory=${memory}"
  "--cpus=${cpus}"
  --tmpfs /tmp:rw,nosuid,nodev,size=256m
  --tmpfs /var/tmp:rw,nosuid,nodev,size=128m
  --workdir /workspace
  --env-file "$agent_dir/sandbox.env"
  -v "$work_dir:/workspace:rw"
  -v "$agent_dir/sandbox-home:/home/agent:rw"
  -v "$sandbox_run:/run/buzz-sandbox:rw"
  -v "$control_dir:/run/buzz-sandbox/control:rw"
  -v "$agent_dir/fresh:/run/buzz-sandbox/fresh:rw"
  -v "$agent_dir/wake:/run/buzz-sandbox/wake:rw"
  -v "$lib_dir:/opt/buzz-host:ro"
)

if [[ -f "$agent_dir/instructions.md" ]]; then
  args+=(-v "$agent_dir/instructions.md:/run/buzz-sandbox/instructions.md:ro")
fi

agy_bin="${BUZZ_HOST_AGY_BIN:-$HOME/.local/share/mise/installs/antigravity-cli/latest/antigravity}"
if [[ -x "$agy_bin" ]]; then
  args+=(-v "$agy_bin:/opt/antigravity/agy:ro")
fi

args+=("$image" node /opt/buzz-host/sandbox/container-entry.mjs)

docker "${args[@]}" &
child=$!
wait "$child"
