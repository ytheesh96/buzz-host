# What the owner's patched Buzz desktop (~/Work/buzz-pkg/patches) does with
# the buzz CLI's agent drafts, which stock Buzz 1.x drops.
DRAFTS_NOTE = """<owner-review-drafts>
Your owner's Buzz desktop shows your agent drafts as review popups:
- `buzz agents draft-create --channel <this chat's channel id> --display-name <name> --system-prompt <instructions>` opens Buzz's Create agent popup, prefilled, for a new agent of your own type (hosted on this server like you).
- `buzz agents draft-update --channel <this chat's channel id> --agent-name <exact current name> [--display-name <new name>] [--system-prompt <instructions>]` opens Buzz's edit popup for one of your owner's agents, yourself included. Only the name and instructions change; --runtime, --provider, --model and --respond-to are ignored.
Nothing is created or changed until your owner saves it. A draft reaches them only while their Buzz desktop is open, and the command succeeding doesn't mean they saw it, so say in the chat what you sent.
</owner-review-drafts>"""


def memory_note():
    """Buzz's memory guide and this agent's core memory, from buzz-host. Empty
    when buzz-host can't be reached, so a turn never waits long on it."""
    if not re.fullmatch(r"[0-9a-f]{64}", agent_pubkey):
        return ""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
            c.settimeout(12)  # a slow relay must not hold the turn long
            c.connect(host_sock)
            c.sendall((json.dumps({"pubkey": agent_pubkey, "name": "memory_core", "args": {}}) + "\n").encode())
            buf = b""
            while b"\n" not in buf:
                chunk = c.recv(65536)
                if not chunk:
                    break
                buf += chunk
        reply = json.loads(buf.split(b"\n", 1)[0] or b"{}")
        if reply.get("error"):
            log(f"memory note: {reply['error']}")
        return (reply.get("result") or "").strip()
    except Exception as e:
        log(f"memory note failed: {e}")
        return ""


def attention_note():
    """buzz-host's attention-note.txt for this agent: Buzz's review note while
    Attention is on (the service keeps it current), else nothing."""
    if not agent_dir:
        return ""
    try:
        with open(os.path.join(agent_dir, "attention-note.txt"), encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def handle_client_line(line):
    """buzz-acp -> adapter. Returns bytes to forward, or None if handled here."""
    try:
        msg = json.loads(line)
    except ValueError:
        return line
    method = msg.get("method")
    params = msg.get("params") or {}
    if method == "initialize":
        params["protocolVersion"] = 1
        params.pop("info", None)
        msg["params"] = params
        return (json.dumps(msg, separators=(",", ":")) + "\n").encode()
    if method in ("session/new", "session/load", "session/resume") and "id" in msg:
        sid = params.get("sessionId")
        with lock:
            pending_new[msg["id"]] = sid
        if method == "session/new" and "buzzHost" in (params.get("_meta") or {}):
            start_in_workspace(msg["id"], params)
            msg["params"] = params
            return (json.dumps(msg, separators=(",", ":")) + "\n").encode()
        if method in ("session/load", "session/resume"):
            key = ""
            stripped_meta = False
            meta = params.get("_meta")
            if isinstance(meta, dict) and "buzzHost" in meta:
                conv = meta.pop("buzzHost", None)
                stripped_meta = True
                if not meta:
                    params.pop("_meta")
                if isinstance(conv, dict):
                    ch, rt = conv.get("channelId") or "", conv.get("rootEventId")
                    if UUID_RE.match(ch) and (not rt or HEX64_RE.match(str(rt))):
                        key = f"{ch}_{rt}" if rt else ch
            if not key and sid:
                key = session_chat_for(sid)
            if key:
                label_mcp(params, key)
                if sid:
                    with lock:
                        sessions.setdefault(sid, {})["key"] = key
                    save_session_chat(sid, key)
                msg["params"] = params
                return (json.dumps(msg, separators=(",", ":")) + "\n").encode()
            if stripped_meta:
                msg["params"] = params
                return (json.dumps(msg, separators=(",", ":")) + "\n").encode()
    elif method == "session/prompt" and "id" in msg:
        sid = params.get("sessionId")
        with lock:
            s = sessions.setdefault(sid, {})
            # Compacting: it runs once the compaction ends (end_compaction).
            if s.get("compacting"):
                s.setdefault("held", []).append(line)
                return None
        stripped, turn = take_turn_meta(params)
        text = "\n".join(b.get("text", "") for b in params.get("prompt") or [] if isinstance(b, dict))
        if turn:
            key, root, events = turn
        else:
            # No events named (a wake or heartbeat, or an unpatched buzz-acp):
            # the chat from the prompt, and no commands or picks.
            key, root, _last, _count = parse_prompt(text)
            events = []
        ev = events[-1] if events else None
        last = (str(ev.get("id", "")), str(ev.get("pubkey", "")), str(ev.get("content", ""))) if ev else None
        count = len(events)
        with lock:
            if key:
                s["key"] = key
            key = s.get("key")
            s["last_used"] = time.monotonic()
        if turn and sid and key:
            save_session_chat(sid, key)
        command = command_of(last) if key else None
        if command:
            event_id = last[0]
            # A top-level mention in a channel starts its own thread; settings
            # made there are meant for the channel.
            settings_key = key.split("_", 1)[0] if key.endswith("_" + event_id) else key
            # Alone, a command is the whole turn. Batched behind other
            # messages, /model /effort /status /help are answered and the turn
            # still runs (with the new setting); /stop and /new end it.
            ends_turn = count <= 1 or command[0] in ("stop", "new")
            if ends_turn:
                threading.Thread(target=handle_command,
                                 args=(msg["id"], command[0], command[1], sid, settings_key, root or None),
                                 daemon=True).start()
                return None
            handle_command(None, command[0], command[1], sid, settings_key, root or None)
        # Only trust structured _meta.buzzHost events (never untrusted prompt text)
        # for the owner-initiated chat gate.
        if turn and key and events:
            me = agent_pubkey.lower()
            for item in reversed(events):
                author = str(item.get("pubkey", "")).lower()
                if HEX64_RE.match(author) and (not me or author != me):
                    record_turn_author(key, author, item.get("id", ""))
                    break
        with lock:
            s["running"] = s.get("running", 0) + 1
            pending_prompt[msg["id"]] = sid
            # Reply fallback: a turn someone asked this agent for.
            if turn and key and any(addresses_agent(e) for e in events):
                turns[msg["id"]] = {"channel": key.split("_", 1)[0], "root": root or None,
                                    "start": time.time(), "text": ""}
                s["turn"] = msg["id"]
        try:
            apply_settings(sid, key, picks_of(events))
        except Exception as e:  # never block a turn on settings
            log(f"applying settings failed: {e}")
        extra = []
        # Memory: once per session in this process, as Buzz's prompt has it.
        with lock:
            first = not s.get("memory_sent")
            s["memory_sent"] = True
        if first:
            note = memory_note()
            if note:
                extra.append(note)
            if re.fullmatch(r"[0-9a-f]{64}", agent_pubkey):
                extra.append(DRAFTS_NOTE)
        # The chat's workspace folders (and its Canvas), as Buzz hands a Solo
        # chat's workspace to a local agent with every turn.
        if key:
            note = workspace_note(sid, key)
            if note:
                extra.append(note)
        note = attention_note()
        # Buzz's end-of-turn Attention review, as Buzz adds it to a local
        # agent's turns. A wake's prompt already ends with it.
        if note and "<attention>" not in text:
            extra.append(note)
        if extra and isinstance(params.get("prompt"), list):
            params["prompt"] += [{"type": "text", "text": t} for t in extra]
        if extra or stripped:
            msg["params"] = params
            return (json.dumps(msg, separators=(",", ":")) + "\n").encode()
    elif method in ("session/set_config_option", "session/set_model") and "id" in msg:
        with lock:
            pending_cfg[msg["id"]] = (params.get("sessionId"), method, params)
    return line


def handle_adapter_line(line):
    """adapter -> buzz-acp. Returns None to swallow."""
    try:
        msg = json.loads(line)
    except ValueError:
        return line
    rid = msg.get("id")
    if isinstance(rid, str) and rid.startswith("buzz-host-") and "method" not in msg:
        with lock:
            w = waiters.get(rid)
            if w:
                w[1] = msg
                w[0].set()
        return None
    if "method" not in msg and rid is not None:
        with lock:
            if rid in pending_cfg:
                sid, method, params = pending_cfg.pop(rid)
                result = msg.get("result")
                if isinstance(result, dict) and sid:
                    s = sessions.setdefault(sid, {})
                    if result.get("configOptions"):
                        s["options"] = result["configOptions"]
                    elif method == "session/set_config_option":
                        for o in s.get("options") or []:
                            if option_id(o) == params.get("configId"):
                                o["currentValue"] = params.get("value")
                    elif method == "session/set_model":
                        o = option_by(s.get("options"), MODEL_KEYS)
                        if o:
                            o["currentValue"] = params.get("modelId")
            elif rid in pending_new:
                sid = (msg.get("result") or {}).get("sessionId") or pending_new[rid]
                pending_new.pop(rid)
                ws = pending_ws.pop(rid, None)
                if sid:
                    s = sessions.setdefault(sid, {})
                    s["options"] = (msg.get("result") or {}).get("configOptions") or s.get("options") or []
                    if ws:
                        s.update(ws)
                        if ws.get("key"):
                            save_session_chat(sid, ws["key"])
            elif rid in pending_prompt:
                sid = pending_prompt.pop(rid)
                if sid in sessions:
                    sessions[sid]["running"] = max(0, sessions[sid].get("running", 1) - 1)
                    if sessions[sid].get("turn") == rid:
                        sessions[sid].pop("turn")
                turn = turns.pop(rid, None)
                if turn and (msg.get("result") or {}).get("stopReason") == "end_turn" and turn["text"].strip():
                    spawn(reply_fallback, turn)
    elif msg.get("method") == "session/update":
        p = msg.get("params") or {}
        upd = p.get("update") or {}
        with lock:
            s = sessions.setdefault(p.get("sessionId"), {})
            if upd.get("sessionUpdate") == "config_option_update" and upd.get("configOptions"):
                s["options"] = upd["configOptions"]
            elif upd.get("sessionUpdate") == "available_commands_update":
                s["commands"] = [c.get("name") for c in upd.get("availableCommands") or [] if isinstance(c, dict)]
            turn = turns.get(s.get("turn"))
            if turn is not None:
                # The reply fallback posts only what comes after the last tool call.
                if upd.get("sessionUpdate") == "agent_message_chunk":
                    content = upd.get("content") or {}
                    if content.get("type") == "text":
                        turn["text"] += content.get("text") or ""
                elif upd.get("sessionUpdate") == "tool_call":
                    turn["text"] = ""
            # A compaction is this proxy's turn: buzz-acp isn't in one.
            if s.get("compacting"):
                return None
    elif "method" in msg and rid is not None:
        sid = (msg.get("params") or {}).get("sessionId")
        with lock:
            compacting = bool(sid and sessions.get(sid, {}).get("compacting"))
        if compacting:  # nothing in buzz-acp is waiting to answer it
            send_adapter({"jsonrpc": "2.0", "id": rid,
                          "error": {"code": -32603, "message": "The session is compacting"}})
            return None
    return line


def pump_client():
    for line in sys.stdin.buffer:
        out = handle_client_line(line)
        if out is None:
            continue
        try:
            send_adapter_raw(out)
        except BrokenPipeError:
            break
    try:
        child.stdin.close()
    except OSError:
        pass


def pump_adapter():
    for line in child.stdout:
        out = handle_adapter_line(line)
        if out is not None:
            with to_client_lock:
                sys.stdout.buffer.write(out)
                sys.stdout.buffer.flush()


if __name__ == "__main__":
    if len(sys.argv) < 2:
        sys.exit("usage: acp-proxy <adapter> [args...]")
    child = subprocess.Popen(sys.argv[1:], stdin=subprocess.PIPE, stdout=subprocess.PIPE, bufsize=0)
    def _forward_term(_signum, _frame):
        try:
            child.terminate()
        except OSError:
            pass
    signal.signal(signal.SIGTERM, _forward_term)
    if control_sock:
        threading.Thread(target=serve_control, daemon=True).start()
    threading.Thread(target=pump_client, daemon=True).start()
    reader = threading.Thread(target=pump_adapter, daemon=True)
    reader.start()
    code = child.wait()
    reader.join(5)
    sys.exit(code)
