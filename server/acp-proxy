                         if os.path.exists(p)), "")
CANVAS_TTL = 15  # seconds a chat's Canvas read is reused
UUID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
HEX64_RE = re.compile(r"^[0-9a-f]{64}$")
restore_file = os.path.join(agent_dir, "model-restore.json") if agent_dir else ""
turn_authors_file = os.path.join(agent_dir, "turn-authors.json") if agent_dir else ""
TURN_AUTHORS_CAP = 200
session_chats_file = os.path.join(agent_dir, "session-chats.json") if agent_dir else ""
SESSION_CHATS_CAP = 500
# The command that compacts a session, by runtime, until it lists its own.
COMPACT_COMMANDS = ("compact", "compress")
DEFAULT_COMPACT = {
    "claude-agent-acp": "compact",
    "codex-acp": "compact",
    "hermes-acp": "compress",
    "agy": "compact",
    "antigravity": "compact",
    "claude": "compact",
    "codex": "compact",
    "hermes": "compress",
