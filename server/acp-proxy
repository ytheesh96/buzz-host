# What the owner's patched Buzz desktop (~/Work/buzz-pkg/patches) does with
# the buzz CLI's agent drafts, which stock Buzz 1.x drops.
DRAFTS_NOTE = """<owner-review-drafts>
Your owner's Buzz desktop shows your agent drafts as review popups:
- `buzz agents draft-create --channel <this chat's channel id> --display-name <name> --system-prompt <instructions>` opens Buzz's Create agent popup, prefilled, for a new agent of your own type (hosted on this server like you).
- `buzz agents draft-update --channel <this chat's channel id> --agent-name <exact current name> [--display-name <new name>] [--system-prompt <instructions>]` opens Buzz's edit popup for one of your owner's agents, yourself included. Only the name and instructions change; --runtime, --provider, --model and --respond-to are ignored.
Nothing is created or changed until your owner saves it. A draft reaches them only while their Buzz desktop is open, and the command succeeding doesn't mean they saw it, so say in the chat what you sent.
</owner-review-drafts>"""


def memory_note():
    """Buzz's memory guide and this agent's core memory, from buzz-host. Empty
    when buzz-host can't be reached, so a turn never waits long on it."""
    if not re.fullmatch(r"[0-9a-f]{64}", agent_pubkey):
        return ""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
            c.settimeout(12)  # a slow relay must not hold the turn long
            c.connect(host_sock)
            c.sendall((json.dumps({"pubkey": agent_pubkey, "name": "memory_core", "args": {}}) + "\n").encode())
            buf = b""
            while b"\n" not in buf:
                chunk = c.recv(65536)
                if not chunk:
                    break
                buf += chunk
        reply = json.loads(buf.split(b"\n", 1)[0] or b"{}")
        if reply.get("error"):
            log(f"memory note: {reply['error']}")
        return (reply.get("result") or "").strip()
    except Exception as e:
        log(f"memory note failed: {e}")
        return ""


def _with_scheduler_guard(note):
    if "built-in timer, cron, or background scheduler" in note:
        return note
    guard = NO_RUNTIME_SCHEDULER_OFF if "Attention is off" in note else NO_RUNTIME_SCHEDULER_ON
    close = "</attention>"
    if note.endswith(close):
        return f"{note[:-len(close)].rstrip()}\n{guard}\n{close}"
    return f"{note}\n{guard}"


def attention_note():
    """buzz-host's attention-note.txt for this agent (both when Attention is on
    and when it is off), always carrying the no-runtime-scheduler guardrail."""
    if not agent_dir:
        return ""
    try:
        with open(os.path.join(agent_dir, "attention-note.txt"), encoding="utf-8") as f:
            text = f.read().strip()
        if text:
            return _with_scheduler_guard(text)
    except OSError:
        pass
    if IS_SANDBOX:
        if os.environ.get("BUZZ_SANDBOX_ATTENTION") == "1":
            return f"<attention>\n{NO_RUNTIME_SCHEDULER_ON}\n</attention>"
        return ATTENTION_OFF_FALLBACK
    return ""


def dispatch_client_line(line):
    """buzz-acp -> adapter. Returns (runtime_id, bytes) or (None, None) if handled here."""
    global init_params_saved
    try:
        msg = json.loads(line)
    except ValueError:
        return DEFAULT_TARGET, line
    method = msg.get("method")
    # Client response to a secondary adapter's JSON-RPC request (e.g. session/request_permission).
    if not method and "id" in msg:
        with lock:
            mapped = pending_adapter_req.pop(msg["id"], None)
        if mapped is not None:
            target_rt, orig_rid = mapped
            msg["id"] = orig_rid
            return target_rt, (json.dumps(msg, separators=(",", ":")) + "\n").encode()
        return DEFAULT_TARGET, line
    params = msg.get("params") or {}
    if method == "initialize":
        params["protocolVersion"] = 1
        params.pop("info", None)
        init_params_saved = dict(params)
        msg["params"] = params
        return DEFAULT_TARGET, (json.dumps(msg, separators=(",", ":")) + "\n").encode()
    if method in ("session/new", "session/load", "session/resume") and "id" in msg:
        sid = params.get("sessionId")
        scrubbed = scrub_mcp_secrets(params)
        # What buzz-acp starts its sessions with, for one this proxy opens on
        # another runtime when the chat moves there (open_runtime_session).
        base = {"cwd": params.get("cwd"), "mcpServers": copy.deepcopy(params.get("mcpServers") or [])}
        if method == "session/new":
            has_meta = "buzzHost" in (params.get("_meta") or {})
            target_rt = start_in_workspace(msg["id"], params) if has_meta else DEFAULT_TARGET
            guarded = apply_runtime_guards(params, target_rt)
            with lock:
                pending_new[msg["id"]] = {"sid": sid, "runtime": target_rt, "base": base}
            if not has_meta and not scrubbed and not guarded:
                return target_rt, line
            msg["params"] = params
            return target_rt, (json.dumps(msg, separators=(",", ":")) + "\n").encode()
        # session/load or session/resume
        target_rt, real_sid = split_sid(sid)
        if target_rt == DEFAULT_TARGET and sid:
            target_rt = session_runtime_for(sid)
        with lock:
            pending_new[msg["id"]] = {"sid": sid, "runtime": target_rt, "base": base}
        changed = scrubbed
        if sid and real_sid != sid:
            params["sessionId"] = real_sid
            changed = True
        key = ""
        meta = params.get("_meta")
        if isinstance(meta, dict) and "buzzHost" in meta:
            conv = meta.pop("buzzHost", None)
            changed = True
            if not meta:
                params.pop("_meta")
            if isinstance(conv, dict):
                ch, rt_ev = conv.get("channelId") or "", conv.get("rootEventId")
                if UUID_RE.match(ch) and (not rt_ev or HEX64_RE.match(str(rt_ev))):
                    key = f"{ch}_{rt_ev}" if rt_ev else ch
        if not key and sid:
            key = session_chat_for(sid)
        if key:
            label_mcp(params, key)
            changed = True
            if sid:
                with lock:
                    s = sessions.setdefault(sid, {})
                    s["key"] = key
                    s["runtime"] = target_rt
                save_session_chat(sid, key, target_rt)
        if apply_runtime_guards(params, target_rt):
            changed = True
        if changed:
            msg["params"] = params
            return target_rt, (json.dumps(msg, separators=(",", ":")) + "\n").encode()
        return target_rt, line
    elif method == "session/prompt" and "id" in msg:
        client_sid = params.get("sessionId")
        with lock:
            sid = aliases.get(client_sid, client_sid)
            redo = redispatch.get(msg["id"])  # this turn's second pass (redo_turn)
        target_rt, real_sid = split_sid(sid)
        with lock:
            s = sessions.setdefault(sid, {})
            if target_rt != DEFAULT_TARGET:
                s["runtime"] = target_rt
            elif parse_target(s.get("runtime")):
                target_rt = parse_target(s["runtime"])[2]
            # Compacting: it runs once the compaction ends (end_compaction).
            if s.get("compacting"):
                s.setdefault("held", []).append(line)
                return None, None
        stripped, turn = take_turn_meta(params)
        text = "\n".join(b.get("text", "") for b in params.get("prompt") or [] if isinstance(b, dict))
        if turn:
            key, root, events = turn
        else:
            # No events named (a wake or heartbeat, or an unpatched buzz-acp):
            # the chat from the prompt, and no commands or picks.
            key, root, _last, _count = parse_prompt(text)
            events = []
        ev = events[-1] if events else None
        last = (str(ev.get("id", "")), str(ev.get("pubkey", "")), str(ev.get("content", ""))) if ev else None
        count = len(events)
        with lock:
            if key:
                s["key"] = key
            key = s.get("key")
            s["last_used"] = time.monotonic()
        if turn and sid and key and sid == client_sid:
            save_session_chat(sid, key, target_rt)
        command = command_of(last) if key and not redo else None
        if command:
            event_id = last[0]
            # A top-level mention in a channel starts its own thread; settings
            # made there are meant for the channel.
            settings_key = key.split("_", 1)[0] if key.endswith("_" + event_id) else key
            # Alone, a command is the whole turn. Batched behind other
            # messages, /model /effort /status /help are answered and the turn
            # still runs (with the new setting); /stop and /new end it.
            ends_turn = count <= 1 or command[0] in ("stop", "new")
            if ends_turn:
                threading.Thread(target=handle_command,
                                 args=(msg["id"], command[0], command[1], sid, settings_key, root or None),
                                 daemon=True).start()
                return None, None
            handle_command(None, command[0], command[1], sid, settings_key, root or None)
        # Only trust structured _meta.buzzHost events (never untrusted prompt text)
        # for the owner-initiated chat gate.
        if turn and key and events:
            me = agent_pubkey.lower()
            for item in reversed(events):
                author = str(item.get("pubkey", "")).lower()
                if HEX64_RE.match(author) and (not me or author != me):
                    record_turn_author(key, author, item.get("id", ""))
                    break
        # A turn runs on its chat's runtime: after a /runtime batched with
        # this message, or a composer pick of a model on another runtime,
        # this proxy opens a session there for it (buzz-acp starts its own
        # from the next message). Opening one, and reading the history a
        # session new to the runtime gets, can take a while: that turn is
        # handled again on a thread of its own (redo), so the other chats'
        # traffic keeps flowing.
        picks = picks_of(events)
        hydrated = False
        switched = bool(redo and redo.get("switched"))
        if key:
            if redo:
                picks = own_picks(picks, target_rt)  # take_runtime_pick ran
            else:
                before_rt = chat_runtime(key)
                try:
                    picks = take_runtime_pick(key, picks)
                except Exception as e:
                    log(f"{key}: taking a runtime pick failed: {e}")
                switched = chat_runtime(key) != before_rt
            want_rt = chat_runtime(key)
            needs_switch = want_rt != target_rt and runtime_available(want_rt)
            with lock:
                first_turn = not s.get("history_checked")
                needs_history = bool(s.get("hydrate_from"))
            needs_history = needs_history or (first_turn and want_rt == target_rt
                                              and bool(wanted_for(key, load_settings()).get("handoff")))
            if not redo and (needs_switch or needs_history):
                with lock:
                    redispatch[msg["id"]] = {"switched": switched}
                spawn(redo_turn, line, msg["id"])
                return None, None
            if needs_switch:
                try:
                    new_sid = open_runtime_session(client_sid, sid, key, want_rt)
                except Exception as e:
                    log(f"{key}: opening a {want_rt} session failed: {e}")
                    rollback_switch(key, want_rt, target_rt, root, e)
                    switched = False
                    picks = own_picks(picks, target_rt)
                else:
                    sid = new_sid
                    target_rt, real_sid = split_sid(sid)
                    with lock:
                        s = sessions.setdefault(sid, {})
                        s["last_used"] = time.monotonic()
            # The first turn of a session on the chat's new runtime gets the
            # chat's recent history.
            with lock:
                first_turn = not s.get("history_checked")
                s["history_checked"] = True
                hydrate_from = s.pop("hydrate_from", None)
            if (not hydrate_from and first_turn and chat_runtime(key) == target_rt
                    and wanted_for(key, load_settings()).get("handoff")):
                hydrate_from = take_handoff(key)
            if hydrate_from:
                switched = True
                note = history_note(key, hydrate_from, target_rt,
                                    {str(e.get("id", "")) for e in events})
                if note and isinstance(params.get("prompt"), list):
                    params["prompt"] = [{"type": "text", "text": note}] + params["prompt"]
                    hydrated = True
        is_worker_chat = bool(key and settings_file and wanted_for(key, load_settings()).get("noOrchestrate"))
        with lock:
            s["running"] = s.get("running", 0) + 1
            pending_prompt[msg["id"]] = sid
            # Reply fallback: a turn someone asked this agent for, OR a wake-driven
            # delegated worker Solo chat (so final text still lands if the worker
            # didn't invoke `buzz messages send`).
            if key and ((turn and any(addresses_agent(e) for e in events)) or is_worker_chat):
                turns[msg["id"]] = {"channel": key.split("_", 1)[0], "root": root or None,
                                    "start": time.time(), "text": ""}
                s["turn"] = msg["id"]
            if key:
                turn_notify[msg["id"]] = {
                    "channel": key.split("_", 1)[0],
                    "root": root or "",
                    "runtime": target_rt,
                }
        try:
            missed = apply_settings(sid, key, picks) or []
        except Exception as e:  # never block a turn on settings
            log(f"applying settings failed: {e}")
            missed = []
        if switched and key:
            note_fallback(key, root, target_rt, missed)
        if key:
            cur_model, cur_effort = current_model_effort(sid)
            spawn(notify_host, "_acp_turn_start", {
                "channel": key.split("_", 1)[0],
                "root": root or "",
                "runtime": target_rt,
                "model": cur_model,
                "effort": cur_effort,
            })
        extra = []
        # Memory: once per session in this process, as Buzz's prompt has it.
        with lock:
            first = not s.get("memory_sent")
            s["memory_sent"] = True
        if first:
            note = memory_note()
            if note:
                extra.append(note)
            if re.fullmatch(r"[0-9a-f]{64}", agent_pubkey):
                extra.append(DRAFTS_NOTE)
        # The chat's workspace folders (and its Canvas), as Buzz hands a Solo
        # chat's workspace to a local agent with every turn.
        if key:
            note = workspace_note(sid, key)
            if note:
                extra.append(note)
        note = attention_note()
        # Buzz's end-of-turn Attention review, as Buzz adds it to a local
        # agent's turns. A wake's prompt already ends with it.
        if note and "<attention>" not in text:
            extra.append(note)
        if extra and isinstance(params.get("prompt"), list):
            params["prompt"] += [{"type": "text", "text": t} for t in extra]
        sid_changed = bool(client_sid and real_sid != client_sid)
        if sid_changed:
            params["sessionId"] = real_sid
        if extra or stripped or sid_changed or hydrated:
            msg["params"] = params
            return target_rt, (json.dumps(msg, separators=(",", ":")) + "\n").encode()
        return target_rt, line
    elif method in ("session/set_config_option", "session/set_model") and "id" in msg:
        sid = params.get("sessionId")
        target_rt, real_sid = split_sid(sid)
        with lock:
            pending_cfg[msg["id"]] = (sid, method, dict(params))
        if sid and real_sid != sid:
            params["sessionId"] = real_sid
            msg["params"] = params
            return target_rt, (json.dumps(msg, separators=(",", ":")) + "\n").encode()
        return target_rt, line
    elif isinstance(params, dict) and params.get("sessionId"):
        sid = params.get("sessionId")
        with lock:
            target_rt, real_sid = split_sid(aliases.get(sid, sid))  # session/cancel follows a moved turn
        if sid and real_sid != sid:
            params["sessionId"] = real_sid
            msg["params"] = params
            return target_rt, (json.dumps(msg, separators=(",", ":")) + "\n").encode()
        return target_rt, line
    return DEFAULT_TARGET, line


def handle_client_line(line):
    """Compatibility wrapper: returns bytes to forward, or None if handled here."""
    return dispatch_client_line(line)[1]


def handle_adapter_line(line, adapter_runtime=None):
    """adapter -> buzz-acp. Returns None to swallow."""
    rt = adapter_runtime or DEFAULT_TARGET
    try:
        msg = json.loads(line)
    except ValueError:
        return line
    rid = msg.get("id")
    rewritten = False
    if isinstance(rid, str) and rid.startswith("buzz-host-") and "method" not in msg:
        with lock:
            w = waiters.get(rid)
            if w:
                w[1] = msg
                w[0].set()
        return None
    if "method" not in msg and rid is not None:
        save_chat_args = None
        with lock:
            if rid in pending_cfg:
                sid, method, params = pending_cfg.pop(rid)
                result = msg.get("result")
                if isinstance(result, dict) and sid:
                    s = sessions.setdefault(sid, {})
                    if result.get("configOptions"):
                        s["options"] = result["configOptions"]
                    elif method == "session/set_config_option":
                        for o in s.get("options") or []:
                            if option_id(o) == params.get("configId"):
                                o["currentValue"] = params.get("value")
                    elif method == "session/set_model":
                        o = option_by(s.get("options"), MODEL_KEYS)
                        if o:
                            o["currentValue"] = params.get("modelId")
            elif rid in pending_new:
                info = pending_new.pop(rid)
                base = None
                if isinstance(info, dict):
                    orig_sid = info.get("sid")
                    new_rt = info.get("runtime") or rt
                    base = info.get("base")
                else:
                    orig_sid = info
                    new_rt = rt
                ws = pending_ws.pop(rid, None)
                err = msg.get("error")
                if err and ws and ws.get("key"):
                    err_msg = (err.get("data") or {}).get("details") if isinstance(err, dict) else None
                    if not err_msg and isinstance(err, dict):
                        err_msg = err.get("message")
                    handoff = wanted_for(ws["key"], load_settings()).get("handoff") if settings_file else None
                    if isinstance(handoff, dict) and new_rt != handoff.get("from"):
                        # The chat just moved to a runtime that can't start
                        # a session (not signed in): back where it was.
                        spawn(rollback_switch, ws["key"], new_rt, handoff.get("from"),
                              ws["key"].split("_", 1)[1] if "_" in ws["key"] else None,
                              err_msg or "session/new failed")
                    spawn(notify_host, "_acp_turn_done", {
                        "channel": ws["key"].split("_", 1)[0],
                        "root": ws["key"].split("_", 1)[1] if "_" in ws["key"] else "",
                        "runtime": new_rt,
                        "stopReason": "",
                        "error": str(err_msg or "session/new failed"),
                        "errorCode": err.get("code") if isinstance(err, dict) else None,
                        "model": "",
                        "effort": "",
                        "finalText": "",
                    })
                raw_sid = (msg.get("result") or {}).get("sessionId")
                ext_sid = join_sid(new_rt, raw_sid) if raw_sid else orig_sid
                if raw_sid and ext_sid != raw_sid and isinstance(msg.get("result"), dict):
                    msg["result"]["sessionId"] = ext_sid
                    rewritten = True
                if ext_sid:
                    s = sessions.setdefault(ext_sid, {})
                    s["runtime"] = new_rt
                    s["options"] = (msg.get("result") or {}).get("configOptions") or s.get("options") or []
                    if base and not err:
                        s["base"] = base
                    if ws:
                        s.update(ws)
                        if ws.get("key"):
                            save_chat_args = (ext_sid, ws["key"], new_rt)
            elif rid in pending_prompt:
                sid = pending_prompt.pop(rid)
                if sid in sessions:
                    sessions[sid]["running"] = max(0, sessions[sid].get("running", 1) - 1)
                    if sessions[sid].get("turn") == rid:
                        sessions[sid].pop("turn")
                turn = turns.pop(rid, None)
                tn = turn_notify.pop(rid, None)
                stop_reason = (msg.get("result") or {}).get("stopReason") or ""
                err = msg.get("error")
                err_msg = ""
                err_code = None
                if isinstance(err, dict):
                    err_msg = str((err.get("data") or {}).get("details") or err.get("message") or "ACP error")
                    err_code = err.get("code")
                elif err:
                    err_msg = str(err)
                done_payload = None
                if tn:
                    cur_model, cur_effort = current_model_effort(sid)
                    done_payload = {
                        "channel": tn["channel"],
                        "root": tn["root"],
                        "runtime": tn["runtime"],
                        "stopReason": stop_reason,
                        "error": err_msg,
                        "errorCode": err_code,
                        "model": cur_model,
                        "effort": cur_effort,
                        "finalText": (turn["text"].strip() if turn else "")[:REPLY_LIMIT],
                    }
                if turn and stop_reason == "end_turn" and turn["text"].strip():
                    if done_payload is not None:
                        spawn(reply_fallback, turn, done_payload)
                    else:
                        spawn(reply_fallback, turn)
                elif done_payload is not None:
                    spawn(notify_host, "_acp_turn_done", done_payload)
        if save_chat_args is not None:
            save_session_chat(*save_chat_args)
    elif msg.get("method") == "session/update":
        p = msg.get("params") or {}
        raw_sid = p.get("sessionId")
        ext_sid = join_sid(rt, raw_sid) if raw_sid else raw_sid
        if raw_sid and ext_sid != raw_sid:
            p["sessionId"] = ext_sid
            rewritten = True
        with lock:
            client_sid = alias_of.get(ext_sid)
        if client_sid:  # a turn this proxy moved to another runtime
            p["sessionId"] = client_sid
            rewritten = True
        upd = p.get("update") or {}
        with lock:
            s = sessions.setdefault(ext_sid, {})
            if upd.get("sessionUpdate") == "config_option_update" and upd.get("configOptions"):
                s["options"] = upd["configOptions"]
            elif upd.get("sessionUpdate") == "available_commands_update":
                s["commands"] = [c.get("name") for c in upd.get("availableCommands") or [] if isinstance(c, dict)]
            turn = turns.get(s.get("turn"))
            if turn is not None:
                # The reply fallback posts only what comes after the last tool call.
                if upd.get("sessionUpdate") == "agent_message_chunk":
                    content = upd.get("content") or {}
                    if content.get("type") == "text":
                        turn["text"] += content.get("text") or ""
                elif upd.get("sessionUpdate") == "tool_call":
                    turn["text"] = ""
            # A compaction is this proxy's turn: buzz-acp isn't in one.
            if s.get("compacting"):
                return None
    elif "method" in msg and rid is not None:
        p = msg.get("params") or {}
        raw_sid = p.get("sessionId") if isinstance(p, dict) else None
        ext_sid = join_sid(rt, raw_sid) if raw_sid else raw_sid
        if raw_sid and ext_sid != raw_sid and isinstance(p, dict):
            p["sessionId"] = ext_sid
            rewritten = True
        with lock:
            compacting = bool(ext_sid and sessions.get(ext_sid, {}).get("compacting"))
            client_sid = alias_of.get(ext_sid)
        if client_sid and isinstance(p, dict):
            p["sessionId"] = client_sid
            rewritten = True
        if compacting:  # nothing in buzz-acp is waiting to answer it
            if rt == DEFAULT_TARGET:
                send_adapter({"jsonrpc": "2.0", "id": rid,
                              "error": {"code": -32603, "message": "The session is compacting"}})
            else:
                send_adapter({"jsonrpc": "2.0", "id": rid,
                              "error": {"code": -32603, "message": "The session is compacting"}}, runtime_id=rt)
            return None
        if rt != DEFAULT_TARGET:
            with lock:
                next_id[0] += 1
                ext_rid = f"buzz-req-{next_id[0]}"
                pending_adapter_req[ext_rid] = (rt, rid)
            msg["id"] = ext_rid
            rewritten = True
    if rewritten:
        return (json.dumps(msg, separators=(",", ":")) + "\n").encode()
    return line


def _iter_stdin_lines():
    """Read newline-delimited bytes from raw fd 0 without holding sys.stdin.buffer's lock.

    Holding CPython's BufferedReader lock in a daemon thread while the main thread
    exits triggers a fatal SIGABRT (_enter_buffered_busy) at interpreter shutdown.
    """
    fd = sys.stdin.fileno()
    buf = b""
    while True:
        try:
            chunk = os.read(fd, 65536)
        except InterruptedError:
            continue
        except OSError:
            break
        if not chunk:
            if buf:
                yield buf
            break
        buf += chunk
        while True:
            nl = buf.find(b"\n")
            if nl < 0:
                break
            yield buf[:nl + 1]
            buf = buf[nl + 1:]


def pump_client():
    for line in _iter_stdin_lines():
        target_rt, out = dispatch_client_line(line)
        if out is None:
            continue
        try:
            if target_rt == DEFAULT_TARGET:
                send_adapter_raw(out)
            else:
                send_adapter_raw(out, runtime_id=target_rt)
        except BrokenPipeError:
            if target_rt == DEFAULT_TARGET:
                break
            _fail_secondary_dispatch(line, target_rt, "Secondary runtime adapter closed stdin")
        except Exception as e:
            if target_rt == DEFAULT_TARGET:
                break
            _fail_secondary_dispatch(line, target_rt, str(e))
    try:
        child.stdin.close()
    except OSError:
        pass
    with adapter_spawn_lock:
        secondary = list(adapters.values())
    for ad in secondary:
        try:
            ad["proc"].stdin.close()
        except OSError:
            pass


def _fail_secondary_dispatch(line, target_rt, err_text):
    log(f"secondary adapter {target_rt} failed: {err_text}")
    try:
        msg = json.loads(line)
    except ValueError:
        return
    rid = msg.get("id")
    ws = None
    tn = None
    with lock:
        if rid is not None:
            pending_new.pop(rid, None)
            ws = pending_ws.pop(rid, None)
            sid = pending_prompt.pop(rid, None)
            if sid and sid in sessions:
                sessions[sid]["running"] = max(0, sessions[sid].get("running", 1) - 1)
                if sessions[sid].get("turn") == rid:
                    sessions[sid].pop("turn")
            turns.pop(rid, None)
            tn = turn_notify.pop(rid, None)
    if rid is not None:
        send_client({"jsonrpc": "2.0", "id": rid, "error": {"code": -32000, "message": err_text}})
    key = (ws or {}).get("key") or ""
    channel = (tn or {}).get("channel") or (key.split("_", 1)[0] if key else "")
    root = (tn or {}).get("root") or (key.split("_", 1)[1] if "_" in key else "")
    if channel:
        spawn(notify_host, "_acp_turn_done", {
            "channel": channel,
            "root": root,
            "runtime": target_rt,
            "stopReason": "",
            "error": err_text,
            "errorCode": -32000,
            "model": "",
            "effort": "",
            "finalText": "",
        })


def _fail_adapter_exit(adapter_runtime, exit_code):
    """Fail every in-flight request/prompt/waiter belonging to a crashed secondary adapter."""
    err_text = f"{adapter_runtime} adapter exited unexpectedly ({exit_code})"
    log(err_text)
    client_rids = []
    done_notifications = []
    with lock:
        # Wake any proxy_request / initialize waiters targeting this runtime.
        for wid, entry in list(waiters.items()):
            if len(entry) >= 3 and entry[2] == adapter_runtime:
                entry[1] = {"error": {"code": -32000, "message": err_text}}
                entry[0].set()
        # Drop any pending adapter-initiated requests for this runtime.
        for ext_rid, (rt_item, _) in list(pending_adapter_req.items()):
            if rt_item == adapter_runtime:
                pending_adapter_req.pop(ext_rid, None)
        # Fail pending session/new, session/load, session/resume for this runtime.
        for rid, info in list(pending_new.items()):
            rt_item = info.get("runtime") if isinstance(info, dict) else DEFAULT_TARGET
            if rt_item == adapter_runtime:
                pending_new.pop(rid, None)
                ws = pending_ws.pop(rid, None)
                client_rids.append(rid)
                if ws and ws.get("key"):
                    key = ws["key"]
                    done_notifications.append({
                        "channel": key.split("_", 1)[0],
                        "root": key.split("_", 1)[1] if "_" in key else "",
                        "runtime": adapter_runtime,
                        "stopReason": "",
                        "error": err_text,
                        "errorCode": -32000,
                        "model": "",
                        "effort": "",
                        "finalText": "",
                    })
        # Fail pending session/set_config_option / session/set_model for this runtime.
        for rid, (sid, _m, _p) in list(pending_cfg.items()):
            if split_sid(sid)[0] == adapter_runtime:
                pending_cfg.pop(rid, None)
                client_rids.append(rid)
        # Fail pending session/prompt turns for this runtime.
        for rid, sid in list(pending_prompt.items()):
            if split_sid(sid)[0] == adapter_runtime:
                pending_prompt.pop(rid, None)
                client_rids.append(rid)
                if sid in sessions:
                    sessions[sid]["running"] = max(0, sessions[sid].get("running", 1) - 1)
                    if sessions[sid].get("turn") == rid:
                        sessions[sid].pop("turn")
                turns.pop(rid, None)
                tn = turn_notify.pop(rid, None)
                if tn:
                    done_notifications.append({
                        "channel": tn["channel"],
                        "root": tn["root"],
                        "runtime": adapter_runtime,
                        "stopReason": "",
                        "error": err_text,
                        "errorCode": -32000,
                        "model": "",
                        "effort": "",
                        "finalText": "",
                    })
    for rid in client_rids:
        try:
            send_client({"jsonrpc": "2.0", "id": rid, "error": {"code": -32000, "message": err_text}})
        except OSError:
            pass
    for payload in done_notifications:
        spawn(notify_host, "_acp_turn_done", payload)


def pump_adapter_proc(proc, adapter_runtime):
    for line in proc.stdout:
        out = handle_adapter_line(line, adapter_runtime=adapter_runtime)
        if out is not None:
            with to_client_lock:
                sys.stdout.buffer.write(out)
                sys.stdout.buffer.flush()
    if adapter_runtime != DEFAULT_TARGET:
        try:
            exit_code = proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            _reap_proc(proc)
            exit_code = proc.poll()
        except OSError:
            exit_code = None
        with adapter_spawn_lock:
            cur = adapters.get(adapter_runtime)
            if cur and cur["proc"] is proc:
                adapters.pop(adapter_runtime, None)
        _fail_adapter_exit(adapter_runtime, exit_code)


def pump_adapter():
    pump_adapter_proc(child, DEFAULT_TARGET)


if __name__ == "__main__":
    if len(sys.argv) < 2:
        sys.exit("usage: acp-proxy <adapter> [args...]")
    atexit.register(cleanup_control_sock)
    child = subprocess.Popen(sys.argv[1:], stdin=subprocess.PIPE, stdout=subprocess.PIPE, bufsize=0)
    def _forward_term(_signum, _frame):
        # Never acquire threading.Locks inside a signal handler (can self-deadlock).
        cleanup_control_sock()
        try:
            child.terminate()
        except OSError:
            pass
        try:
            for ad in list(adapters.values()):
                try:
                    ad["proc"].terminate()
                except OSError:
                    pass
        except RuntimeError:
            pass
    signal.signal(signal.SIGTERM, _forward_term)
    if control_dir or control_sock:
        threading.Thread(target=serve_control, daemon=True).start()
    threading.Thread(target=pump_client, daemon=True).start()
    reader = threading.Thread(target=pump_adapter, daemon=True)
    reader.start()
    try:
        code = child.wait()
        reader.join(5)
    finally:
        cleanup_control_sock()
        with adapter_spawn_lock:
            secondary = list(adapters.values())
        for ad in secondary:
            _reap_proc(ad["proc"])
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.flush()
        except Exception:
            pass
    # Exit without running Py_FinalizeEx against live daemon threads (e.g.
    # pump_client blocked in read(0) when terminated before stdin closes).
    exit_code = code if isinstance(code, int) and code >= 0 else (128 + abs(code) if isinstance(code, int) else 1)
    os._exit(exit_code)
