def log(msg):
    print(f"acp-proxy: {msg}", file=sys.stderr, flush=True)


def split_sid(ext_sid):
    """Split a proxy session id into (target_id, adapter_session_id)."""
    if isinstance(ext_sid, str) and ext_sid.startswith("rt:"):
        parts = ext_sid.split(":", 2)
        if len(parts) == 3 and parts[2]:
            tag = parts[1]
            if tag in KNOWN_RUNTIMES:
                return tag, parts[2]
            if tag.startswith("hermes@"):
                prof = tag[len("hermes@"):]
                if prof and prof.lower() != "default" and PROFILE_RE.match(prof):
                    return f"hermes:{prof}", parts[2]
    return DEFAULT_TARGET, ext_sid


def join_sid(runtime_id, real_sid):
    """Map an adapter session id to the external id buzz-acp sees."""
    if not real_sid or not runtime_id or runtime_id == DEFAULT_TARGET:
        return real_sid
    parsed = parse_target(runtime_id)
    if parsed and parsed[0] == "hermes" and parsed[1]:
        tag = f"hermes@{parsed[1]}"
    else:
        tag = parsed[0] if parsed else runtime_id
    return f"rt:{tag}:{real_sid}"


def _adapter_overrides():
    override = os.environ.get("BUZZ_HOST_ADAPTERS_JSON", "")
    if not override:
        return {}
    try:
        mapping = json.loads(override)
        return mapping if isinstance(mapping, dict) else {}
    except ValueError:
        return {}


def hermes_profiles():
    """Named Hermes profiles available on this host (excluding 'default')."""
    found = set()
    profiles_dir = os.path.join(HERMES_ROOT, "profiles")
    try:
        for name in os.listdir(profiles_dir):
            if name.startswith(".") or name.lower() == "default" or not PROFILE_RE.match(name):
                continue
            d = os.path.join(profiles_dir, name)
            if os.path.isdir(d) and (
                os.path.isfile(os.path.join(d, "profile.yaml"))
                or os.path.isfile(os.path.join(d, "config.yaml"))
            ):
                found.add(name)
    except OSError:
        pass
    for key in _adapter_overrides():
        parsed = parse_target(key)
        if parsed and parsed[0] == "hermes" and parsed[1]:
            found.add(parsed[1])
    if DEFAULT_RUNTIME == "hermes" and DEFAULT_PROFILE:
        found.add(DEFAULT_PROFILE)
    return sorted(found)


def hermes_profile_exists(profile):
    if not profile:
        return True
    if not PROFILE_RE.match(profile) or profile.lower() == "default":
        return False
    if f"hermes:{profile}" in _adapter_overrides():
        return True
    if DEFAULT_RUNTIME == "hermes" and profile == DEFAULT_PROFILE:
        return True
    d = hermes_home(profile)
    return os.path.isdir(d) and (
        os.path.isfile(os.path.join(d, "profile.yaml"))
        or os.path.isfile(os.path.join(d, "config.yaml"))
    )


def resolve_adapter_spec(runtime_id):
    """Return (argv, extra_env) for spawning `runtime_id` directly (without nesting acp-proxy).
    A None value in extra_env removes that key from the child environment."""
    parsed = parse_target(runtime_id)
    if not parsed:
        raise RuntimeError(f"Unknown runtime: {runtime_id}")
    rt, profile, canonical = parsed
    mapping = _adapter_overrides()
    entry = mapping.get(canonical) if canonical in mapping else mapping.get(rt)
    if entry is not None:
        base_env = {}
        if rt == "hermes":
            base_env["HERMES_HOME"] = hermes_home(profile) if profile else None
        elif rt == "claude":
            base_env["CLAUDE_CODE_DISABLE_CRON"] = os.environ.get("CLAUDE_CODE_DISABLE_CRON", "1")
        if isinstance(entry, list) and entry:
            return [str(x) for x in entry], base_env
        if isinstance(entry, dict) and entry.get("cmd"):
            base_env.update(dict(entry.get("env") or {}))
            return [str(x) for x in entry["cmd"]], base_env
    if rt == "claude":
        return [os.path.join(host_lib, "npm", "node_modules", ".bin", "claude-agent-acp")], {
            "CLAUDE_CODE_DISABLE_CRON": os.environ.get("CLAUDE_CODE_DISABLE_CRON", "1"),
        }
    if rt == "codex":
        return [os.path.join(host_lib, "npm", "node_modules", ".bin", "codex-acp")], {}
    if rt == "hermes":
        return [os.path.expanduser("~/.local/bin/hermes-acp")], {
            "HERMES_ACP_SKIP_CONFIGURED_MCP": os.environ.get("HERMES_ACP_SKIP_CONFIGURED_MCP", "1"),
            "HERMES_HOME": hermes_home(profile) if profile else None,
        }
    if rt == "antigravity":
        agy = os.path.expanduser("~/.local/share/mise/installs/antigravity-cli/latest/agy")
        if not (os.path.isfile(agy) and os.access(agy, os.X_OK)):
            agy = os.path.expanduser("~/.local/share/mise/shims/agy")
        return [agy, "acp", "--dangerously-skip-permissions"], {}
    raise RuntimeError(f"Unknown runtime: {runtime_id}")


def runtime_available(runtime_id):
    """Whether this proxy can start `runtime_id` (its own target always)."""
    parsed = parse_target(runtime_id)
    if not parsed:
        return False
    rt, profile, canonical = parsed
    if canonical == DEFAULT_TARGET:
        return True
    if rt == "hermes" and profile and not hermes_profile_exists(profile):
        return False
    try:
        argv, _env = resolve_adapter_spec(canonical)
    except RuntimeError:
        return False
    return bool(argv) and os.path.isfile(argv[0]) and os.access(argv[0], os.X_OK)


def ensure_hermes_profile(profile):
    """Ask buzz-host to install/enable buzz-host-session-env in this Hermes profile
    before spawning hermes-acp on demand."""
    if IS_SANDBOX or not host_sock or not os.path.exists(host_sock):
        return
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
            c.settimeout(60)
            c.connect(host_sock)
            c.sendall((json.dumps({
                "pubkey": agent_pubkey or "",
                "name": "_ensure_hermes_profile",
                "args": {"profile": profile or ""},
            }) + "\n").encode())
            buf = b""
            while b"\n" not in buf:
                chunk = c.recv(4096)
                if not chunk:
                    break
                buf += chunk
        reply_obj = json.loads(buf.split(b"\n", 1)[0] or b"{}")
        if reply_obj.get("error"):
            err = str(reply_obj["error"])
            if err.startswith("No tool "):
                log(f"ensure_hermes_profile({profile or 'default'}): host lacks handler ({err})")
                return
            raise RuntimeError(err)
    except OSError as e:
        log(f"ensure_hermes_profile({profile or 'default'}) skipped: {e}")


def send_adapter_raw(data, runtime_id=None):
    rt = runtime_id or DEFAULT_TARGET
    if rt == DEFAULT_TARGET:
        with to_adapter_lock:
            child.stdin.write(data)
            child.stdin.flush()
        return
    ad = ensure_adapter(rt)
    with ad["lock"]:
        ad["proc"].stdin.write(data)
        ad["proc"].stdin.flush()


def send_adapter(obj, runtime_id=None):
    send_adapter_raw((json.dumps(obj, separators=(",", ":")) + "\n").encode(), runtime_id=runtime_id)


def send_client(obj):
    data = (json.dumps(obj, separators=(",", ":")) + "\n").encode()
    with to_client_lock:
        sys.stdout.buffer.write(data)
        sys.stdout.buffer.flush()


def proxy_request(method, params, timeout=20, runtime_id=None):
    rt = runtime_id or DEFAULT_TARGET
    with lock:
        next_id[0] += 1
        rid = f"buzz-host-{next_id[0]}"
        ev = threading.Event()
        waiters[rid] = [ev, None, rt]
    send_adapter({"jsonrpc": "2.0", "id": rid, "method": method, "params": params}, runtime_id=runtime_id)
    ev.wait(timeout)
    with lock:
        entry = waiters.pop(rid, None)
        return entry[1] if entry else None


def _reap_proc(proc):
    try:
        proc.terminate()
    except OSError:
        pass
    try:
        proc.wait(timeout=2)
    except subprocess.TimeoutExpired:
        try:
            proc.kill()
        except OSError:
            pass
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            pass
    except OSError:
        pass


def ensure_adapter(runtime_id):
    """Lazily spawn and ACP-v1 initialize a secondary runtime (or Hermes profile) adapter."""
    parsed = parse_target(runtime_id)
    canonical = parsed[2] if parsed else runtime_id
    if canonical == DEFAULT_TARGET:
        return None
    with adapter_spawn_lock:
        existing = adapters.get(canonical)
        if existing and existing["proc"].poll() is None and existing["ready"]:
            return existing
        rt_lock = adapter_init_locks.setdefault(canonical, threading.Lock())
    with rt_lock:
        existing = adapters.get(canonical)
        if existing and existing["proc"].poll() is None and existing["ready"]:
            return existing
        if parsed and parsed[0] == "hermes":
            ensure_hermes_profile(parsed[1])
        argv, extra_env = resolve_adapter_spec(canonical)
        env = dict(os.environ)
        for k, v in extra_env.items():
            if v is None:
                env.pop(k, None)
            else:
                env[k] = v
        proc = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, bufsize=0, env=env)
        ad = {
            "runtime": canonical,
            "proc": proc,
            "lock": threading.Lock(),
            "ready": False,
        }
        with adapter_spawn_lock:
            adapters[canonical] = ad
        threading.Thread(target=pump_adapter_proc, args=(proc, canonical), daemon=True).start()
        params = dict(init_params_saved or {"protocolVersion": 1, "clientCapabilities": {}})
        params["protocolVersion"] = 1
        params.pop("info", None)
        with lock:
            next_id[0] += 1
            rid = f"buzz-host-{next_id[0]}"
            ev = threading.Event()
            waiters[rid] = [ev, None, canonical]
        try:
            with ad["lock"]:
                proc.stdin.write((json.dumps({"jsonrpc": "2.0", "id": rid, "method": "initialize", "params": params},
                                             separators=(",", ":")) + "\n").encode())
                proc.stdin.flush()
        except OSError as e:
            with lock:
                waiters.pop(rid, None)
            with adapter_spawn_lock:
                if adapters.get(canonical) is ad:
                    adapters.pop(canonical, None)
            _reap_proc(proc)
            raise RuntimeError(f"{canonical} adapter failed during initialize: {e}") from e
        ev.wait(60)
        with lock:
            entry = waiters.pop(rid, None)
            resp = entry[1] if entry else None
        if not resp or "error" in resp:
            with adapter_spawn_lock:
                if adapters.get(canonical) is ad:
                    adapters.pop(canonical, None)
            _reap_proc(proc)
            err = (resp or {}).get("error") or {}
            raise RuntimeError(err.get("message") or f"{canonical} adapter failed to initialize")
        ad["ready"] = True
        log(f"started secondary adapter for runtime {canonical}")
        return ad


# ---------- cross-process file lock ----------

def _pid_alive(pid):
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError as e:
        return e.errno == errno.EPERM


def _lock_is_stale(lock_path):
    try:
        st = os.stat(lock_path)
        try:
            with open(lock_path) as f:
                raw = f.read().strip()
            pid = int(raw) if raw.isdigit() else 0
            if pid > 0 and not _pid_alive(pid):
                return True
        except OSError:
            pass
        return (time.time() - st.st_mtime) > LOCK_STALE
    except OSError:
        return False


def _try_reap_stale_lock(lock_path):
    reap_path = lock_path + ".reap"
    try:
        fd = os.open(reap_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        try:
            os.write(fd, f"{os.getpid()}\n".encode())
        finally:
            os.close(fd)
    except FileExistsError:
        if _lock_is_stale(reap_path):
            try:
                os.unlink(reap_path)
            except OSError:
                pass
        return
    except OSError:
        return
    try:
        if _lock_is_stale(lock_path):
            try:
                os.unlink(lock_path)
            except OSError:
                pass
    finally:
        try:
            os.unlink(reap_path)
        except OSError:
            pass


@contextlib.contextmanager
def file_lock(path):
    """Advisory cross-process lock matching server/file-lock.mjs (<path>.lock)."""
    lock_path = path + ".lock"
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, mode=0o700, exist_ok=True)
    deadline = time.monotonic() + LOCK_TIMEOUT
    our_ino = None
    while our_ino is None:
        try:
            fd = os.open(lock_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
            try:
                os.write(fd, f"{os.getpid()}\n".encode())
                our_ino = os.fstat(fd).st_ino
            finally:
                os.close(fd)
        except FileExistsError:
            if _lock_is_stale(lock_path):
                _try_reap_stale_lock(lock_path)
                continue
            if time.monotonic() >= deadline:
                raise TimeoutError(f"timed out waiting for lock {lock_path}")
            time.sleep(0.01)
    try:
        yield
    finally:
        try:
            if os.stat(lock_path).st_ino == our_ino:
                os.unlink(lock_path)
        except OSError:
            pass


def write_private_json(path, data):
    tmp = f"{path}.{os.getpid()}.{threading.get_ident()}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def update_json_locked(path, mutator):
    with file_lock(path):
        try:
            with open(path) as f:
                data = json.load(f)
            if not isinstance(data, dict):
                data = {}
        except (OSError, ValueError):
            data = {}
        result = mutator(data)
        if result is not None:
            write_private_json(path, result)
            return result
        return data


# ---------- config options ----------

def option_by(options, wanted):
    for o in options or []:
        if o.get("category") in wanted or o.get("id") in wanted or o.get("configId") in wanted:
            return o
    return None


def option_id(o):
    return o.get("id") or o.get("configId")


def choices(o):
    out = []
    for v in (o or {}).get("options") or []:
        if isinstance(v, dict) and "value" in v:
            out.append((v["value"], v.get("name") or v["value"]))
        elif isinstance(v, dict) and "options" in v:  # grouped
            out += [(g["value"], g.get("name") or g["value"]) for g in v["options"]]
    return out


def load_settings():
    if not settings_file:
        return {}
    try:
        with open(settings_file) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_settings(all_settings):
    if not settings_file:
        return
    with file_lock(settings_file):
        write_private_json(settings_file, all_settings)


def update_settings(key, mutator):
    """Atomically read-modify-write one chat's entry in chat-settings.json."""
    if not settings_file:
        return {}

    def _mutate(data):
        entry = dict(data.get(key) or {}) if isinstance(data.get(key), dict) else {}
        mutator(entry)
        if entry:
            data[key] = entry
        else:
            data.pop(key, None)
        return data

    return update_json_locked(settings_file, _mutate)


def _norm_profile(v):
    s = str(v or "").strip()
    if not s or s.lower() == "default" or not PROFILE_RE.match(s):
        return ""
    return s


def _entry_target(raw, inherited):
    if not isinstance(raw, dict):
        return inherited
    has_rt = isinstance(raw.get("runtime"), str) and raw["runtime"].strip() != ""
    has_prof = "profile" in raw and isinstance(raw.get("profile"), str)
    if not has_rt and not has_prof:
        return inherited
    if has_rt:
        parsed = parse_target(raw["runtime"])
        if not parsed:
            return inherited
        rt, prof, _ = parsed
        if rt != "hermes":
            return rt
        if not prof and has_prof:
            prof = _norm_profile(raw["profile"])
        return format_target("hermes", prof)
    inh = parse_target(inherited)
    if not inh or inh[0] != "hermes":
        return inherited
    return format_target("hermes", _norm_profile(raw["profile"]))


def wanted_for(key, settings):
    """A thread uses its channel's settings unless it has its own.
    If the thread sets a different runtime or Hermes profile than its channel,
    it does not inherit the channel's model or effort (those belonged to the
    old runtime/profile)."""
    if "_" not in key:
        entry = settings.get(key)
        return dict(entry) if isinstance(entry, dict) else {}
    base_raw = settings.get(key.split("_", 1)[0])
    own_raw = settings.get(key)
    base = dict(base_raw) if isinstance(base_raw, dict) else {}
    own = dict(own_raw) if isinstance(own_raw, dict) else {}
    base_target = _entry_target(base, DEFAULT_TARGET)
    own_target = _entry_target(own, base_target)
    if own_target != base_target:
        base.pop("model", None)
        base.pop("effort", None)
        base.pop("profile", None)
    base.update(own)
    return base


def chat_runtime(key):
    """Configured canonical runtime target for `key` if valid, else DEFAULT_TARGET."""
    if not key or not settings_file:
        return DEFAULT_TARGET
    settings = load_settings()
    if "_" not in key:
        return _entry_target(settings.get(key), DEFAULT_TARGET)
    base_target = _entry_target(settings.get(key.split("_", 1)[0]), DEFAULT_TARGET)
    return _entry_target(settings.get(key), base_target)


def split_pick(value):
    """(target_id, model) for a composer model pick: 'codex::gpt-5' or
    'hermes:career-lead::go:flash' names its runtime/profile; a plain id is
    this agent's own runtime/profile."""
    if isinstance(value, str) and PICK_RUNTIME_SEP in value:
        rt_spec, model = value.split(PICK_RUNTIME_SEP, 1)
        parsed = parse_target(rt_spec)
        if parsed and model:
            return parsed[2], model
    return DEFAULT_TARGET, value


def request_fresh(*keys):
    """Ask the patched buzz-acp to start these chats in a fresh session."""
    if not fresh_dir:
        return False
    os.makedirs(fresh_dir, exist_ok=True)
    for k in dict.fromkeys(k for k in keys if k):
        open(os.path.join(fresh_dir, k), "w").close()
    return True


def switch_chat_runtime(key, runtime_id, model=None, from_rt=None):
    """Make `runtime_id` (canonical target, e.g. 'codex', 'hermes', or
    'hermes:career-lead') the chat's runtime. The chat's model and effort were
    the old runtime/profile's, so they go (unless `model` names the new one's).
    The next message starts a fresh session there, given the chat's recent
    history (`handoff`). Returns the settings dropped, {kind: value}."""
    parsed = parse_target(runtime_id)
    if not parsed:
        raise ValueError(f"Unknown runtime: {runtime_id}")
    rt, profile, canonical = parsed
    dropped = {}
    # A thread without a runtime of its own uses its channel's.
    inherited = chat_runtime(key.split("_", 1)[0]) if "_" in key else DEFAULT_TARGET
    inh_parsed = parse_target(inherited)

    def _mutate(entry):
        for kind in ("model", "effort"):
            if entry.get(kind):
                dropped[kind] = entry.pop(kind)
        if canonical == inherited:
            entry.pop("runtime", None)
            entry.pop("profile", None)
        else:
            entry["runtime"] = rt
            if rt == "hermes":
                if profile:
                    entry["profile"] = profile
                elif inh_parsed and inh_parsed[0] == "hermes" and inh_parsed[1]:
                    entry["profile"] = ""
                else:
                    entry.pop("profile", None)
            else:
                entry.pop("profile", None)
        if model and model.lower() != "default":
            entry["model"] = model
            if dropped.get("model") == model:
                dropped.pop("model")
        if fresh_dir:
            entry["handoff"] = {"from": from_rt or DEFAULT_TARGET, "at": int(time.time())}
    update_settings(key, _mutate)
    request_fresh(key)
    log(f"{key}: runtime {from_rt} -> {canonical}" + (f" ({model})" if model else ""))
    return dropped


def take_handoff(key):
    """The runtime a chat moved from, once: for the first turn of the session
    it starts on its new runtime."""
    found = {}

    def _mutate(entry):
        h = entry.pop("handoff", None)
        if isinstance(h, dict) and not found:
            found.update(h)
    if not key or not settings_file:
        return None
    settings = load_settings()
    for k in dict.fromkeys([key, key.split("_", 1)[0]]):
        if isinstance(settings.get(k), dict) and "handoff" in settings[k]:
            update_settings(k, _mutate)
    return found.get("from") or None


def load_restore():
    try:
        with open(restore_file) as f:
            value = json.load(f)
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError):
        return {}


def restore_point(sid):
    """{kind: value} the session ran before this proxy changed it."""
    with lock:
        s = sessions.setdefault(sid, {})
        if "restore" not in s:
            s["restore"] = dict(load_restore().get(sid) or {}) if restore_file else {}
        return dict(s["restore"])


def save_restore_point(sid, restore):
    with lock:
        sessions.setdefault(sid, {})["restore"] = dict(restore)
    if not restore_file:
        return
    try:
        def _mutate(everything):
            if restore:
                everything[sid] = dict(restore)
            else:
                everything.pop(sid, None)
            return everything
        update_json_locked(restore_file, _mutate)
    except (OSError, TimeoutError) as e:
        log(f"saving {restore_file} failed: {e}")


def record_turn_author(key, author, event_id=""):
    """Persist the latest person-authored turn per chat for orchestrator's
    owner-initiated chat gate."""
    if not turn_authors_file or not key:
        return
    author = str(author or "").lower()
    if not HEX64_RE.match(author):
        return
    if agent_pubkey and author == agent_pubkey.lower():
        return
    event_id = str(event_id or "").lower()
    if not HEX64_RE.match(event_id):
        event_id = ""
    try:
        def _mutate(data):
            data[key] = {"author": author, "eventId": event_id, "at": int(time.time())}
            if len(data) > TURN_AUTHORS_CAP:
                keep = sorted(
                    data.items(),
                    key=lambda kv: (kv[1].get("at", 0) if isinstance(kv[1], dict) else 0),
                    reverse=True,
                )[:TURN_AUTHORS_CAP]
                data = dict(keep)
            return data
        update_json_locked(turn_authors_file, _mutate)
    except (OSError, TimeoutError) as e:
        log(f"saving {turn_authors_file} failed: {e}")


def load_session_chats():
    if not session_chats_file:
        return {}
    try:
        with open(session_chats_file) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_session_chat(sid, key, runtime_id=None):
    """Remember sessionId -> {key, runtime} across restarts so session/load and
    session/resume still label buzz-mcp with BUZZHOST_CHAT and route to the right runtime."""
    if not session_chats_file or not sid or not key:
        return
    rt = runtime_id or split_sid(sid)[0]
    try:
        def _mutate(data):
            prev = data.get(sid)
            if isinstance(prev, dict) and prev.get("key") == key and prev.get("runtime", DEFAULT_TARGET) == rt:
                return None
            data[sid] = {"key": key, "runtime": rt, "at": int(time.time())}
            if len(data) > SESSION_CHATS_CAP:
                keep = sorted(
                    data.items(),
                    key=lambda kv: (kv[1].get("at", 0) if isinstance(kv[1], dict) else 0),
                    reverse=True,
                )[:SESSION_CHATS_CAP]
                data = dict(keep)
            return data
        update_json_locked(session_chats_file, _mutate)
    except (OSError, TimeoutError) as e:
        log(f"saving {session_chats_file} failed: {e}")


def session_chat_for(sid):
    entry = load_session_chats().get(sid)
    if isinstance(entry, dict):
        return entry.get("key") or ""
    if isinstance(entry, str):
        return entry
    return ""


def session_runtime_for(sid):
    rt, _ = split_sid(sid)
    if rt != DEFAULT_TARGET:
        return rt
    with lock:
        saved = sessions.get(sid, {}).get("runtime")
    parsed = parse_target(saved) if isinstance(saved, str) else None
    if parsed:
        return parsed[2]
    entry = load_session_chats().get(sid)
    if isinstance(entry, dict):
        parsed_entry = parse_target(entry.get("runtime"))
        if parsed_entry:
            return parsed_entry[2]
    return DEFAULT_TARGET


def picks_of(events):
    """{"runtime", "model", "effort"} the owner picked for this agent in Buzz's
    composer: tags ["runtime"|"model"|"effort", <this agent>, value] on the
    latest of the owner's messages this turn answers. Their other messages, and
    anyone else's, are not asked: only the owner is honoured, as Buzz does for
    local agents."""
    me = agent_pubkey.lower()
    if not owner or not HEX64_RE.match(me):
        return {}
    for ev in reversed(events or []):
        if str(ev.get("pubkey", "")).lower() != owner:
            continue
        found = {}
        for tag in ev.get("tags") or []:
            if (isinstance(tag, list) and len(tag) >= 3 and tag[0] in ("runtime", "model", "effort")
                    and str(tag[1]).lower() == me and isinstance(tag[2], str) and tag[2]):
                found.setdefault(tag[0], tag[2])
        return found
    return {}


def apply_settings(sid, key, picks=None):
    """Put the session on this turn's model and effort: the owner's pick on
    the message, else the chat's /model and /effort, else what it ran before
    this proxy changed it (the agent's own). The model goes first: the
    effort levels offered can change with it. Returns what the session
    doesn't offer, [(kind, value, source)]."""
    want = wanted_for(key, load_settings()) if key and settings_file else {}
    picks = picks or {}
    restore = restore_point(sid)
    rt, real_sid = split_sid(sid)
    missed = []
    for kind, keyset in (("model", MODEL_KEYS), ("effort", EFFORT_KEYS)):
        with lock:
            options = list(sessions.get(sid, {}).get("options") or [])
        opt = option_by(options, keyset)
        if not opt:
            continue
        current = opt.get("currentValue")
        source = "pick" if picks.get(kind) else "setting"
        value = picks.get(kind) or want.get(kind)
        if not value:
            if kind not in restore:
                continue
            value, source = restore[kind], "restore"
        if value == current:
            if source == "restore":
                restore.pop(kind)
                save_restore_point(sid, restore)
            continue
        if value not in {v for v, _ in choices(opt)}:
            log(f"{key}: {kind} {value!r} ({source}) not offered; keeping {current!r}")
            missed.append((kind, value, source))
            if source == "restore":
                restore.pop(kind)
                save_restore_point(sid, restore)
            continue
        req_params = {"sessionId": real_sid, "configId": option_id(opt), "value": value}
        resp = (proxy_request("session/set_config_option", req_params)
                if rt == DEFAULT_TARGET
                else proxy_request("session/set_config_option", req_params, runtime_id=rt))
        if resp and "result" in resp:
            new = (resp["result"] or {}).get("configOptions")
            with lock:
                s = sessions.setdefault(sid, {})
                if new:
                    s["options"] = new
                else:
                    opt["currentValue"] = value
                    s["options"] = options
            if source == "restore":
                restore.pop(kind)
            elif kind not in restore and current is not None:
                restore[kind] = current
            save_restore_point(sid, restore)
            log(f"{key}: {kind} -> {value} ({source})")
        else:
            log(f"{key}: setting {kind} failed: {resp and resp.get('error')}")
    return missed


# ---------- workspaces ----------

def local_path(given):
    """The directory on this server a chat's folder names, or None. `~` is
    this server's home; a laptop path under /home/<user>/ or /Users/<user>/
    that is missing here maps to the same path under this server's home."""
    p = (given or "").strip()
    if p == "~" or p.startswith("~/"):
        cand = os.path.expanduser(p)
    elif os.path.isabs(p):
        cand = p
    else:
        return None
    cand = os.path.normpath(cand)
    if os.path.isdir(cand):
        return cand
    m = re.match(r"^/(?:home|Users)/[^/]+/(.+)$", p)
    if m:
        alt = os.path.normpath(os.path.join(os.path.expanduser("~"), m.group(1)))
        if os.path.isdir(alt):
            return alt
    return None


def canvas_workspace(channel, fresh=False):
    """workspace.mjs's reading of the chat's Canvas, reused for CANVAS_TTL
    seconds; {} when it can't be read (the caller keeps what it knew)."""
    if not UUID_RE.match(channel or "") or not WORKSPACE_HELPER:
        return {}
    now = time.monotonic()
    with lock:
        hit = canvas_cache.get(channel)
    if hit and not fresh and now - hit[0] < CANVAS_TTL:
        return hit[1]
    try:
        r = subprocess.run(["node", WORKSPACE_HELPER, channel], capture_output=True, text=True, timeout=8)
        out = json.loads(r.stdout or "{}")
    except Exception as e:
        log(f"{channel}: reading the Canvas failed: {e}")
        return {}
    if out.get("error"):
        log(f"{channel}: reading the Canvas failed: {out['error']}")
        return {}
    if out.get("reason") and out.get("author"):
        log(f"{channel}: Canvas not used: {out['reason']}")
    with lock:
        canvas_cache[channel] = (now, out)
    return out


def chat_workspace(key, fresh=False):
    """{"source": "command"|"canvas"|None, "folders": [given...], "local":
    {given: dir or None}, "canvas": text or None, "worktree": {...} or None}.
    A /workspace setting wins over the Canvas; `/workspace off` saves []."""
    if IS_SANDBOX:
        return {"source": None, "folders": [], "local": {}, "canvas": None, "worktree": None, "worktree_dir": None}
    channel = (key or "").split("_", 1)[0]
    chosen = wanted_for(key, load_settings()).get("workspace") if settings_file else None
    ws = {"source": None, "folders": [], "canvas": None, "worktree": None}
    if isinstance(chosen, list):
        ws.update(source="command" if chosen else None, folders=[str(f) for f in chosen])
    else:
        found = canvas_workspace(channel, fresh)
        if found.get("folders"):
            ws.update(source="canvas", folders=list(found["folders"]),
                      canvas=found.get("canvas"), worktree=found.get("worktree"))
    ws["local"] = {f: local_path(f) for f in ws["folders"]}
    # Worktree mode: new worktrees go here, so it may not exist yet.
    loc = (ws["worktree"] or {}).get("location") or ""
    ws["worktree_dir"] = local_path(loc) or (
        os.path.normpath(os.path.expanduser(loc)) if loc == "~" or loc.startswith("~/") or os.path.isabs(loc) else None)
    return ws


def workspace_dirs(ws):
    """The chat's folders found here, then its worktree location (Buzz's
    `workspaceDirectories` order). The first is where a session starts."""
    seen, out = set(), []
    for d in [ws["local"].get(f) for f in ws["folders"]] + [ws.get("worktree_dir")]:
        if d and d not in seen:
            seen.add(d)
            out.append(d)
    return out


def unframed(text):
    """Keep a Canvas from closing the note it sits in (Buzz's `unframed`)."""
    return re.sub(r"</?\s*workspace-canvas\b[^>]*>", lambda m: m.group(0).replace("<", "&lt;"), text, flags=re.I)


def workspace_note(sid, key):
    """Buzz's per-turn workspace note for this chat, or "" when it has none.
    Once a chat had one, a turn without one says to disregard it."""
    try:
        ws = chat_workspace(key)
    except Exception as e:
        log(f"{key}: workspace lookup failed: {e}")
        return ""
    with lock:
        s = sessions.setdefault(sid, {})
        had, s["had_workspace"] = s.get("had_workspace"), bool(ws["folders"])
        start, home = s.get("start"), s.get("home")
    if not ws["folders"]:
        if not had:
            return ""
        return ("<workspace-canvas>\nThis chat has no workspace from its owner now. Disregard any "
                "earlier workspace Canvas, its instructions and its folders.\n</workspace-canvas>")
    dirs = workspace_dirs(ws)
    lines = []
    if dirs:
        mine = f" (`{home}`)" if home else ""
        lines.append("This chat's work happens in these folders, not your own workspace: "
                     + ", ".join(f"`{d}`" for d in dirs)
                     + f". `cd` into the one you need; your workspace{mine} keeps your notes.")
    if start:
        lines.append(f"This session started in `{start}`.")
    missing = [f for f in ws["folders"] if not ws["local"].get(f)]
    if missing:
        lines.append("Not found on this server (you run on the owner's server, not their laptop; "
                     "tell the owner if you need them): " + ", ".join(f"`{f}`" for f in missing) + ".")
    if ws["source"] == "canvas":
        head = ("This chat's Canvas as of this message: its standing instructions for this chat, which "
                "the owner's messages override. It replaces any earlier workspace Canvas.")
        return f"<workspace-canvas>\n{head} {' '.join(lines)}\n\n{unframed(ws['canvas'].strip())}\n</workspace-canvas>"
    return ("<workspace-canvas>\nThe owner set this chat's workspace folders. " + " ".join(lines)
            + "\n</workspace-canvas>")


def start_in_workspace(msg_id, params):
    """session/new: take buzz-acp's `_meta.buzzHost`, pick the chat's runtime
    (defaulting to this proxy's runtime), and for Claude/Codex/Antigravity
    start the session in the chat's first folder found here."""
    meta = params.get("_meta")
    conv = meta.pop("buzzHost", None) if isinstance(meta, dict) else None
    if isinstance(meta, dict) and not meta:
        params.pop("_meta")
    if not isinstance(conv, dict):
        return DEFAULT_TARGET
    channel, root = conv.get("channelId") or "", conv.get("rootEventId")
    if not UUID_RE.match(channel) or (root and not re.fullmatch(r"[0-9a-f]{64}", root)):
        return DEFAULT_TARGET
    key = f"{channel}_{root}" if root else channel
    target_runtime = chat_runtime(key)
    label_mcp(params, key)
    home = params.get("cwd")
    start = None
    try:
        ws = chat_workspace(key, fresh=True)
        dirs = workspace_dirs(ws)
        found = [d for d in (ws["local"].get(f) for f in ws["folders"]) if d]
        if runtime_starts_in_folder(target_runtime) and found:
            start = found[0]
            params["cwd"] = start
            if runtime_extra_dirs(target_runtime):
                extra = list(params.get("additionalDirectories") or [])
                for d in [home] + dirs[1:]:
                    if d and d != start and d not in extra:
                        extra.append(d)
                params["additionalDirectories"] = extra
            log(f"{key}: session starts in {start} ({target_runtime})")
    except Exception as e:  # never block a session on its workspace
        log(f"{key}: workspace lookup failed: {e}")
    with lock:
        pending_ws[msg_id] = {"key": key, "start": start, "home": home, "runtime": target_runtime}
    return target_runtime


# ---------- runtime switching ----------

def fetch_history(key):
    """The chat's recent Buzz messages, oldest first (thread scope: its thread)."""
    channel, _, root = key.partition("_")
    args = ["buzz", "--format", "json", "messages"]
    args += (["thread", "--channel", channel, "--event", root] if root
             else ["get", "--channel", channel, "--limit", str(HISTORY_FETCH)])
    r = subprocess.run(args, capture_output=True, text=True, timeout=30)
    if r.returncode != 0:
        raise RuntimeError((r.stderr or r.stdout).strip()[:300] or f"exit {r.returncode}")
    items = json.loads(r.stdout or "[]")
    if isinstance(items, dict):
        items = items.get("messages") or items.get("events") or []
    return sorted((e for e in items if isinstance(e, dict)), key=lambda e: e.get("created_at") or 0)


def history_lines(rows, exclude=()):
    """Bounded transcript lines: the newest HISTORY_MESSAGES, within HISTORY_BYTES."""
    lines = []
    for e in rows:
        text = str(e.get("content") or "").strip()
        if not text or e.get("id") in exclude or e.get("kind") not in (1, 9):  # messages, not reactions
            continue
        if len(text) > HISTORY_ITEM_CHARS:
            text = text[:HISTORY_ITEM_CHARS].rstrip() + "…"
        author = str(e.get("pubkey") or "").lower()
        who = ("owner" if owner and author == owner
               else "you" if agent_pubkey and author == agent_pubkey.lower()
               else (author[:8] + "…") if author else "someone")
        at = time.strftime("%Y-%m-%d %H:%M UTC", time.gmtime(e.get("created_at") or 0))
        lines.append(f"[{at}] {who}: {text}")
    lines = lines[-HISTORY_MESSAGES:]
    while lines and len("\n".join(lines).encode()) > HISTORY_BYTES:
        lines.pop(0)
    return lines


def history_note(key, from_rt, to_rt, exclude=()):
    """The chat's recent messages for a session that starts on a new runtime."""
    try:
        lines = history_lines(fetch_history(key), exclude)
    except Exception as e:  # never block a turn on history
        log(f"{key}: history for the runtime handoff failed: {e}")
        return ""
    if not lines:
        return ""
    return ("<conversation-history>\n"
            f"This chat moved from {runtime_title(from_rt)} to {runtime_title(to_rt)}, so this session is new. "
            "These are the chat's recent Buzz messages before this turn, oldest first (messages only, no tool "
            "activity); carry on from them.\n\n" + "\n".join(lines) + "\n</conversation-history>")


def open_runtime_session(client_sid, sid, key, runtime_id):
    """Open a session on `runtime_id` for the chat buzz-acp's `client_sid`
    serves (now running in `sid`), as buzz-acp's own session/new would (same
    cwd and MCP servers, the chat's workspace), and route `client_sid`'s
    turns there. Returns the new session id."""
    with lock:
        base = copy.deepcopy(sessions.get(sid, {}).get("base") or {})
        from_rt = sessions.get(sid, {}).get("runtime") or split_sid(sid)[0]
    channel, _, root = key.partition("_")
    params = {"cwd": base.get("cwd") or os.getcwd(),  # agent-run starts us in the agent's folder
              "mcpServers": base.get("mcpServers") or [],
              "_meta": {"buzzHost": {"channelId": channel, "rootEventId": root or None}}}
    with lock:
        next_id[0] += 1
        ws_id = f"buzz-host-ws-{next_id[0]}"
    start_in_workspace(ws_id, params)
    apply_runtime_guards(params, runtime_id)
    with lock:
        ws = pending_ws.pop(ws_id, None)
    resp = proxy_request("session/new", params, timeout=120, runtime_id=runtime_id)
    result = (resp or {}).get("result") if isinstance(resp, dict) else None
    if not isinstance(result, dict) or not result.get("sessionId"):
        err = (resp or {}).get("error") if isinstance(resp, dict) else None
        detail = ((err.get("data") or {}).get("details") or err.get("message")) if isinstance(err, dict) else None
        raise RuntimeError(detail or "no answer from the runtime")
    ext = join_sid(runtime_id, result["sessionId"])
    with lock:
        ns = sessions.setdefault(ext, {})
        if ws:
            ns.update(ws)
        ns.update({"runtime": runtime_id, "options": result.get("configOptions") or [], "key": key,
                   "base": base, "hydrate_from": from_rt})
        old = aliases.pop(client_sid, None)
        if old:
            alias_of.pop(old, None)
        if ext != client_sid:
            aliases[client_sid] = ext
            alias_of[ext] = client_sid
    log(f"{key}: opened a {runtime_id} session for this turn ({ext})")
    return ext


def take_runtime_pick(key, picks):
    """Apply a composer runtime/profile pick: either an explicit `runtime` tag
    ('claude', 'hermes', 'hermes:career-lead') with optional clean `model`, or a
    legacy prefixed model pick ('codex::gpt-5'). Moves the chat when the target
    differs from the chat's current runtime/profile. Returns this turn's picks
    (with `runtime` removed and any `::` prefix stripped from `model`)."""
    picks = dict(picks or {})
    raw_rt = picks.pop("runtime", None)
    raw_model = picks.get("model")
    if not key or (not raw_rt and not raw_model):
        return picks
    if raw_rt is not None:
        parsed = parse_target(raw_rt)
        if not parsed:
            log(f"{key}: ignoring unknown runtime pick {raw_rt!r}")
            picks.pop("model", None)
            return picks
        rt = parsed[2]
        model = raw_model
        if isinstance(model, str) and PICK_RUNTIME_SEP in model:
            m_rt, m_id = split_pick(model)
            if m_rt == rt:
                model = m_id
                picks["model"] = model
    else:
        rt, model = split_pick(raw_model)
        picks["model"] = model
    current = chat_runtime(key)
    if rt == current:
        return picks  # a pick on the chat's own runtime/profile runs just this turn
    if wanted_for(key, load_settings()).get("noOrchestrate"):
        log(f"{key}: ignoring a pick on {rt}: a worker chat keeps its runtime")
        picks.pop("model", None)
        return picks
    if not runtime_available(rt):
        log(f"{key}: ignoring a pick on {rt}: not installed or profile missing here")
        picks.pop("model", None)
        return picks
    switch_chat_runtime(key, rt, model, current)
    return picks


def own_picks(picks, runtime_id):
    """This turn's picks for a session on `runtime_id`: a runtime or model
    picked for another runtime/profile isn't one."""
    picks = dict(picks or {})
    raw_rt = picks.pop("runtime", None)
    if raw_rt is not None:
        parsed = parse_target(raw_rt)
        if not parsed or parsed[2] != runtime_id:
            picks.pop("model", None)
            return picks
    if picks.get("model"):
        rt, model = split_pick(picks["model"])
        if rt == runtime_id or PICK_RUNTIME_SEP not in picks["model"]:
            picks["model"] = model
        else:
            picks.pop("model")
    return picks


def rollback_switch(key, runtime_id, from_rt, root, error):
    """The chat's new runtime couldn't start a session (installed, but not
    signed in): it goes back to `from_rt`, and the chat is told."""
    from_parsed = parse_target(from_rt) if isinstance(from_rt, str) else None
    from_target = from_parsed[2] if from_parsed else DEFAULT_TARGET
    from_base, from_prof, _ = parse_target(from_target) or (DEFAULT_RUNTIME, DEFAULT_PROFILE, DEFAULT_TARGET)
    inherited = chat_runtime(key.split("_", 1)[0]) if "_" in key else DEFAULT_TARGET
    inh_parsed = parse_target(inherited)

    def _mutate(entry):
        if _entry_target(entry, inherited) != runtime_id:
            return  # moved on meanwhile
        entry.pop("handoff", None)
        entry.pop("model", None)  # the new runtime's, if it came with the move
        if from_target == inherited:
            entry.pop("runtime", None)
            entry.pop("profile", None)
        else:
            entry["runtime"] = from_base
            if from_base == "hermes":
                if from_prof:
                    entry["profile"] = from_prof
                elif inh_parsed and inh_parsed[0] == "hermes" and inh_parsed[1]:
                    entry["profile"] = ""
                else:
                    entry.pop("profile", None)
            else:
                entry.pop("profile", None)
    if key and settings_file and chat_runtime(key) == runtime_id:
        update_settings(key, _mutate)
        if fresh_dir:
            with contextlib.suppress(OSError):
                os.remove(os.path.join(fresh_dir, key))
    stays = runtime_title(chat_runtime(key)) if key else runtime_title(from_target)
    log(f"{key}: {runtime_id} couldn't start a session ({error}); back on {stays}")
    spawn(reply, key.split("_", 1)[0], root or None,
          f"Couldn't start a {runtime_title(runtime_id)} session ({error}), so this chat stays on {stays}.")


def redo_turn(line, rid):
    """Handle a session/prompt again off the input thread (see redispatch)."""
    out, target_rt = None, DEFAULT_TARGET
    try:
        target_rt, out = dispatch_client_line(line)
    except Exception as e:
        log(f"handling a moved turn failed: {e}")
        send_client({"jsonrpc": "2.0", "id": rid, "error": {"code": -32603, "message": str(e)}})
    finally:
        with lock:
            redispatch.pop(rid, None)
    if out is None:
        return
    try:
        send_adapter_raw(out, runtime_id=target_rt)
    except Exception as e:
        _fail_secondary_dispatch(out, target_rt, str(e))


def note_fallback(key, root, runtime_id, missed):
    """After a move to another runtime: a model or effort it doesn't offer
    goes (from the chat's settings too), and the chat is told."""
    gone = [(kind, value) for kind, value, source in missed if source != "restore"]
    if not gone:
        return
    def _drop(entry):  # a picked model on another runtime was saved too
        for kind, value in gone:
            if entry.get(kind) == value:
                entry.pop(kind)
    update_settings(key, _drop)
    title = runtime_title(runtime_id)
    spawn(reply, key.split("_", 1)[0], root or None,
          " and ".join(f"{kind} `{value}`" for kind, value in gone)
          + f" isn't offered on {title}, so this chat uses {title}'s default.")


# ---------- chat commands ----------

def parse_prompt(text):
    """(chat key, reply-to root or None, last event (id, author, content) or None, event count)."""
    ch = CHANNEL_RE.search(text)
    if not ch:
        return None, None, None, 0
    scope = SCOPE_RE.search(text)
    root = THREAD_RE.search(text)
    threaded = bool(scope and scope.group(1) == "thread" and root)
    events = EVENT_RE.findall(text)
    last = events[-1] if events else None
    key = f"{ch.group(1)}_{root.group(1)}" if threaded else ch.group(1)
    return key, (root.group(1) if threaded else None), last, len(events)


def take_turn_meta(params):
    """session/prompt: remove the patched buzz-acp's `_meta.buzzHost` and
    return (found, (key, root, events) or None): the chat the turn is in and
    the Buzz events it answers, oldest first, each {id, pubkey, kind,
    content, tags}."""
    meta = params.get("_meta")
    if not isinstance(meta, dict) or "buzzHost" not in meta:
        return False, None
    turn = meta.pop("buzzHost")
    if not meta:
        params.pop("_meta")
    if not isinstance(turn, dict):
        return True, None
    channel, root = str(turn.get("channelId") or ""), turn.get("rootEventId")
    if not UUID_RE.match(channel) or (root is not None and not (isinstance(root, str) and HEX64_RE.match(root))):
        return True, None
    events = [e for e in turn.get("events") or [] if isinstance(e, dict)]
    return True, ((f"{channel}_{root}" if root else channel), root, events)


def command_of(event):
    """('model', ['opus']) for an owner's '@agent /model opus', else None."""
    if not event or not owner:
        return None
    _event_id, author, content = event
    if author.lower() != owner:
        return None
    line = MENTION_RE.sub("", content.strip().splitlines()[0] if content.strip() else "")
    if not line.startswith("/"):
        return None
    parts = line[1:].split()
    if not parts or parts[0].lower() not in COMMANDS:
        return None
    if parts[0].lower() == "workspace":  # paths may be quoted or `code`
        try:
            parts = shlex.split(line[1:])
        except ValueError:
            pass
        parts = [parts[0]] + [p.strip().strip("`") for p in parts[1:] if p.strip().strip("`")]
    return parts[0].lower(), parts[1:]


def reply(channel, root, text):
    args = ["buzz", "messages", "send", "--channel", channel, "--content", text]
    if root:
        args += ["--reply-to", root]
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=60)
        if r.returncode != 0:
            log(f"reply failed: {(r.stderr or r.stdout).strip()[:300]}")
    except Exception as e:
        log(f"reply failed: {e}")


def spawn(fn, *args):
    threading.Thread(target=fn, args=args, daemon=True).start()


def addresses_agent(event):
    """A person's event that tags this agent: a mention, or a Solo chat or DM message."""
    if not isinstance(event, dict) or not HEX64_RE.match(agent_pubkey):
        return False
    author = str(event.get("pubkey", "")).lower()
    if not HEX64_RE.match(author) or author == agent_pubkey:
        return False
    return any(isinstance(t, list) and len(t) >= 2 and t[0] == "p" and str(t[1]).lower() == agent_pubkey
               for t in event.get("tags") or [])


def _is_orch_prompt(event):
    """True for the visible prompt posted by the orchestrator when opening/steering a Solo worker."""
    return any(isinstance(t, list) and len(t) >= 2 and t[0] == "t" and t[1] == "buzz.orch.prompt"
               for t in event.get("tags") or [])


def agent_posted(channel, since):
    """Whether the agent posted in `channel` after `since` (unix seconds).
    Raises when the relay can't be asked."""
    r = subprocess.run(["buzz", "--format", "json", "messages", "get", "--channel", channel,
                        "--since", str(int(since) - 2), "--limit", "200"],
                       capture_output=True, text=True, timeout=30)
    if r.returncode != 0:
        raise RuntimeError((r.stderr or r.stdout).strip()[:200] or f"exit {r.returncode}")
    events = json.loads(r.stdout or "[]")
    return any(isinstance(e, dict) and str(e.get("pubkey", "")).lower() == agent_pubkey
               and (e.get("created_at") or 0) >= int(since)
               and not _is_orch_prompt(e) for e in events)


def notify_host(name, args):
    """Best-effort fire-and-forget notification to buzz-host over attention.sock."""
    if not HEX64_RE.match(agent_pubkey or "") or not host_sock:
        return
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
            c.settimeout(3)
            c.connect(host_sock)
            c.sendall((json.dumps({"pubkey": agent_pubkey, "name": name, "args": args}) + "\n").encode())
            buf = b""
            while b"\n" not in buf:
                chunk = c.recv(4096)
                if not chunk:
                    break
                buf += chunk
    except Exception:
        pass


def current_model_effort(sid):
    with lock:
        options = list(sessions.get(sid, {}).get("options") or [])
    m = option_by(options, MODEL_KEYS)
    e = option_by(options, EFFORT_KEYS)
    return (m.get("currentValue") or "") if m else "", (e.get("currentValue") or "") if e else ""


def reply_fallback(turn, done_payload=None):
    """Post a finished turn's final text when the agent didn't reply itself."""
    posted = False
    text = turn["text"].strip()
    if text:
        should_post = False
        try:
            should_post = not agent_posted(turn["channel"], turn["start"])
        except Exception as e:
            log(f"{turn['channel']}: reply fallback skipped, can't tell whether the agent replied: {e}")
        if should_post:
            if len(text) > REPLY_LIMIT:
                text = text[:REPLY_LIMIT].rstrip() + "…"
            log(f"{turn['channel']}: the agent ended its turn without replying; posting its final text ({len(text)} chars)")
            reply(turn["channel"], turn["root"], text)
            posted = True
    if done_payload is not None:
        done_payload = dict(done_payload)
        done_payload["fallbackPosted"] = posted
        notify_host("_acp_turn_done", done_payload)


# Env entries buzz-acp gives its MCP servers that must not reach the adapter.
# claude-agent-acp hands MCP configs to the claude CLI as a --mcp-config JSON
# argument, and any local user can read another process's argv (ps,
# /proc/<pid>/cmdline). buzz-mcp.mjs reads the agent's key from its own file,
# so it doesn't need the key in its env.
MCP_SECRET_ENV = {"BUZZ_PRIVATE_KEY"}


def scrub_mcp_secrets(params):
    """Drop MCP_SECRET_ENV entries from every MCP server's env. True if any."""
    changed = False
    for server in params.get("mcpServers") or []:
        if not isinstance(server, dict) or not isinstance(server.get("env"), list):
            continue
        env = [e for e in server["env"] if not (isinstance(e, dict) and e.get("name") in MCP_SECRET_ENV)]
        if len(env) != len(server["env"]):
            server["env"] = env
            changed = True
    return changed


def label_mcp(params, key):
    """Tell the session's buzz MCP server which chat it serves (BUZZHOST_CHAT)
    and suppress orch_* tools when this chat is a delegated worker Solo chat."""
    no_orch = bool(key and settings_file and wanted_for(key, load_settings()).get("noOrchestrate"))
    for server in params.get("mcpServers") or []:
        if not isinstance(server, dict) or server.get("name") != "buzz":
            continue
        env = [
            e for e in server.get("env") or []
            if not (isinstance(e, dict) and e.get("name") in ("BUZZHOST_CHAT", "BUZZHOST_NO_ORCHESTRATE"))
        ]
        env.append({"name": "BUZZHOST_CHAT", "value": key})
        if no_orch:
            env.append({"name": "BUZZHOST_NO_ORCHESTRATE", "value": "1"})
        server["env"] = env


def apply_runtime_guards(params, runtime_id):
    """Apply runtime-specific tool guards on session/new, session/load, and session/resume.
    For Claude Code, disallows built-in cron/wakeup tools so all scheduled wakes
    flow through Buzz Attention (visible to the owner). Returns True if params changed."""
    if base_runtime(runtime_id) != "claude":
        return False
    meta = params.get("_meta")
    if not isinstance(meta, dict):
        meta = {}
        params["_meta"] = meta
    cc = meta.get("claudeCode")
    if not isinstance(cc, dict):
        cc = {}
        meta["claudeCode"] = cc
    opts = cc.get("options")
    if not isinstance(opts, dict):
        opts = {}
        cc["options"] = opts
    existing = list(opts.get("disallowedTools") or [])
    merged = list(existing)
    for tool in CLAUDE_DISALLOWED_TOOLS:
        if tool not in merged:
            merged.append(tool)
    if merged == existing and "disallowedTools" in opts:
        return False
    opts["disallowedTools"] = merged
    return True


def describe(sid, key):
    with lock:
        options = list(sessions.get(sid, {}).get("options") or [])
    want = wanted_for(key, load_settings())
    chosen_rt = chat_runtime(key)
    with lock:
        running_rt = sessions.get(sid, {}).get("runtime") or split_sid(sid)[0]
    has_custom_rt = bool(want.get("runtime") or "profile" in want)
    lines = [f"Runtime: {runtime_title(chosen_rt)}" + ("" if has_custom_rt else " (agent default)")
             + (f" (running: {runtime_title(running_rt)})" if running_rt != chosen_rt else "")]
    for kind, keyset in (("Model", MODEL_KEYS), ("Effort", EFFORT_KEYS)):
        opt = option_by(options, keyset)
        chosen = want.get(kind.lower())
        current = opt.get("currentValue") if opt else None
        if opt:
            lines.append(f"{kind}: {chosen or 'default'}" + (f" (running: {current})" if current and current != chosen else ""))
        elif chosen:
            lines.append(f"{kind}: {chosen}")
    return lines


def describe_workspace(ws, where, start):
    host, home = socket.gethostname(), os.path.expanduser("~")
    if not ws["folders"]:
        return (f"Workspace for {where}: none, so the agent works in its own folder. Set one with "
                f"`/workspace <path>...` (paths on {host}; `~` is `{home}`), or file the chat in a Buzz "
                "workspace that has folders.")
    shown = []
    for f in ws["folders"]:
        d = ws["local"].get(f)
        shown.append(f"`{f}`" + (f" → `{d}`" if d and d != f else "") + ("" if d else " (not found on this server)"))
    text = (f"Workspace for {where} ({'from its Canvas' if ws['source'] == 'canvas' else 'set with /workspace'}): "
            + ", ".join(shown) + ".")
    if ws.get("worktree"):
        text += f" New worktrees go under `{ws['worktree']['location']}` from `{ws['worktree']['baseBranch']}`."
    if start:
        text += f" This session started in `{start}`."
    elif STARTS_IN_FOLDER:
        text += " The next new session starts in the first folder found here."
    else:
        text += " This runtime keeps its own folder; each message names the workspace folders."
    return text


def set_workspace(args, key, where):
    host, home = socket.gethostname(), os.path.expanduser("~")
    word = args[0].lower()
    if word in ("default", "canvas"):
        update_settings(key, lambda entry: entry.pop("workspace", None))
        text = f"Workspace for {where}: its Canvas's (Buzz workspace folders), if it has any."
    elif word in ("off", "none"):
        update_settings(key, lambda entry: entry.__setitem__("workspace", []))
        text = f"Workspace for {where}: none; the agent works in its own folder and ignores Canvas folders."
    else:
        missing = [f for f in args if not local_path(f)]
        if missing:
            return ("Not found on " + host + ": " + ", ".join(f"`{f}`" for f in missing)
                    + f". Folders must exist on {host} (`~` is `{home}`). Nothing changed.")
        update_settings(key, lambda entry: entry.__setitem__("workspace", list(args)))
        text = f"Workspace for {where}: " + ", ".join(
            f"`{f}`" + (f" → `{local_path(f)}`" if local_path(f) != f else "") for f in args) + "."
    with lock:
        canvas_cache.pop(key.split("_", 1)[0], None)
    if runtime_starts_in_folder(chat_runtime(key)) and fresh_dir:
        os.makedirs(fresh_dir, exist_ok=True)
        open(os.path.join(fresh_dir, key), "w").close()
        return text + " The next message starts a fresh session there."
    return text + " Applies from the next message."


def runtime_options():
    items = []
    for r in KNOWN_RUNTIMES:
        if r == "hermes":
            avail = runtime_available("hermes")
            items.append("`hermes`" + ("" if avail else " (not installed)"))
            if avail:
                for p in hermes_profiles():
                    items.append(f"`hermes:{p}`")
        else:
            items.append(f"`{r}`" + ("" if runtime_available(r) else " (not installed)"))
    return ", ".join(items)


def set_runtime(args, sid, key, where):
    """/runtime [<name> [<model>]|default]: the runtime (or Hermes profile) this chat runs on."""
    want = wanted_for(key, load_settings())
    current = chat_runtime(key)
    if not args:
        whose = "set for this chat" if (want.get("runtime") or "profile" in want) else "the agent's default"
        return (f"Runtime for {where}: {runtime_title(current)} (`{current}`, {whose}). "
                f"Options: {runtime_options()}. Set with `/runtime <name> [<model>]` or `/runtime default`.")
    if want.get("noOrchestrate"):
        return (f"This is a worker chat the orchestrator runs on {runtime_title(current)}; "
                "its runtime stays as it is.")
    raw = args[0].strip()
    # `default` clears the chat's own runtime: a thread's goes back to its channel's.
    inherited = chat_runtime(key.split("_", 1)[0]) if "_" in key else DEFAULT_TARGET
    if raw.lower() == "default":
        new_rt = inherited
    else:
        parsed = parse_target(raw)
        if not parsed:
            return f"`{args[0]}` isn't a runtime. Options: {runtime_options()}."
        new_rt = parsed[2]
    if not runtime_available(new_rt):
        p = parse_target(new_rt)
        if p and p[0] == "hermes" and p[1] and not hermes_profile_exists(p[1]):
            profs = ", ".join(["`default`"] + [f"`{x}`" for x in hermes_profiles()])
            return f"Hermes profile `{p[1]}` doesn't exist on {socket.gethostname()}. Profiles: {profs}. Nothing changed."
        return f"{runtime_title(new_rt)} isn't installed on {socket.gethostname()}. Nothing changed."
    model = args[1] if len(args) > 1 else None
    if new_rt == current:
        if not model:
            return f"{where[0].upper() + where[1:]} already runs on {runtime_title(current)}."
        return run_command("model", [model], sid, key, None)
    dropped = switch_chat_runtime(key, new_rt, model, current)
    title = runtime_title(new_rt)
    text = f"Runtime for {where}: {title}."
    if model and model.lower() != "default":
        text += f" Model: `{model}`."
    elif dropped:
        text += (f" Model and effort: {title}'s default ("
                 + ", ".join(f"`{v}`" for v in dropped.values())
                 + f" stayed with {runtime_title(current)}).")
    if fresh_dir:
        return text + f" The next message starts a fresh {title} session, given this chat's recent messages."
    return text + " Applies from the next message."


def set_profile(args, sid, key, where):
    """/profile [<name>|default]: switch this chat to a Hermes profile."""
    profs = ["default"] + hermes_profiles()
    if not args:
        current = chat_runtime(key)
        parsed = parse_target(current)
        listing = ", ".join(f"`{p}`" for p in profs)
        if parsed and parsed[0] == "hermes":
            active_prof = parsed[1] or "default"
            return (f"Hermes profile for {where}: `{active_prof}`. "
                    f"Profiles: {listing}. Switch with `/profile <name>` or `/profile default`.")
        return (f"{where[0].upper() + where[1:]} currently runs on {runtime_title(current)}. "
                f"Hermes profiles: {listing}. Switch to one with `/profile <name>`.")
    name = args[0].strip()
    target = "hermes" if name.lower() == "default" else f"hermes:{name}"
    return set_runtime([target] + args[1:], sid, key, where)


def provider_of(value):
    """'nous' for 'nous:anthropic/x'; 'custom:local' for 'custom:local:x' (Hermes ids)."""
    parts = value.split(":")
    if len(parts) < 2:
        return None
    return f"{parts[0]}:{parts[1]}" if parts[0] == "custom" and len(parts) > 2 else parts[0]


def by_provider(offered):
    """{provider: [model ids]} when (nearly) every id names its provider, else None."""
    ids = [v for v, _ in offered]
    if not ids or sum(1 for v in ids if provider_of(v)) < 0.8 * len(ids):
        return None
    groups = {}
    for v in ids:
        groups.setdefault(provider_of(v) or "other", []).append(v)
    return groups


def in_scope(session_key, key):
    """A chat/thread key covers itself; a bare channel key also covers its threads."""
    return session_key == key or ("_" not in key and (session_key or "").startswith(key + "_"))


def run_command(cmd, args, sid, key, root):
    channel = key.split("_", 1)[0]
    where = "this thread" if "_" in key else "this chat"
    with lock:
        sid = aliases.get(sid, sid)  # the session this chat's turns run in
        options = list(sessions.get(sid, {}).get("options") or [])
    if cmd in ("model", "effort"):
        keyset = MODEL_KEYS if cmd == "model" else EFFORT_KEYS
        opt = option_by(options, keyset)
        with lock:
            session_rt = sessions.get(sid, {}).get("runtime") or split_sid(sid)[0]
        # Moved to another runtime, not yet started there: its list is unknown.
        offered = choices(opt) if session_rt == chat_runtime(key) else []
        current = wanted_for(key, load_settings()).get(cmd) or "default"
        groups = by_provider(offered) if cmd == "model" else None
        if not args:
            if groups:
                providers = ", ".join(f"`{p}` ({len(v)})" for p, v in sorted(groups.items()))
                return (f"Model for {where}: {current}. Providers: {providers}. "
                        "List one with `/model <provider>`; set with `/model <provider> <model>`, "
                        "`/model <id>` or `/model default`.")
            listing = ", ".join(f"`{v}`" for v, _ in offered) or "(the runtime lists none)"
            return f"{cmd.title()} for {where}: {current}. Options: {listing}. Set with `/{cmd} <id>` or `/{cmd} default`."
        value = args[0]
        if groups and value in groups and len(args) == 1 and value not in {v for v, _ in offered}:
            names = ", ".join(f"`{v[len(value) + 1:]}`" for v in groups[value])
            return f"`{value}` models: {names}. Set with `/model {value} <model>`."
        if groups and len(args) >= 2 and value in groups:
            value = f"{value}:{args[1]}"
        if value.lower() != "default" and offered and value not in {v for v, _ in offered}:
            if groups:
                return (f"`{value}` isn't offered. Providers: "
                        + ", ".join(f"`{p}`" for p in sorted(groups))
                        + ". List one with `/model <provider>`.")
            return f"`{value}` isn't offered. Options: " + ", ".join(f"`{v}`" for v, _ in offered)
        final_val = ["default"]
        def _apply(entry):
            if value.lower() == "default":
                entry.pop(cmd, None)
                final_val[0] = "default"
            else:
                entry[cmd] = value
                final_val[0] = value
        update_settings(key, _apply)
        return f"{cmd.title()} for {where}: {final_val[0]}. Applies from the next message."
    if cmd == "runtime":
        return set_runtime(args, sid, key, where)
    if cmd == "profile":
        return set_profile(args, sid, key, where)
    if cmd == "workspace":
        if args:
            return set_workspace(args, key, where)
        with lock:
            start = sessions.get(sid, {}).get("start")
        return describe_workspace(chat_workspace(key, fresh=True), where, start)
    if cmd == "new":
        if not fresh_dir:
            return "Fresh sessions need the patched buzz-acp (build-acp.sh)."
        os.makedirs(fresh_dir, exist_ok=True)
        open(os.path.join(fresh_dir, key), "w").close()
        return f"The next message in {where} starts a fresh session."
    if cmd == "stop":
        with lock:
            running = [s for s, st in sessions.items() if in_scope(st.get("key"), key) and st.get("running", 0) > 0]
        for s in running:
            rt, real_sid = split_sid(s)
            if rt == DEFAULT_TARGET:
                send_adapter({"jsonrpc": "2.0", "method": "session/cancel", "params": {"sessionId": real_sid}})
            else:
                send_adapter({"jsonrpc": "2.0", "method": "session/cancel", "params": {"sessionId": real_sid}}, runtime_id=rt)
        return f"Stopped the running turn in {where}." if running else f"Nothing is running in {where}."
    if cmd == "status":
        lines = describe(sid, key)
        ws = chat_workspace(key)
        with lock:
            start = sessions.get(sid, {}).get("start")
        if ws["folders"]:
            lines.append("Workspace: " + ", ".join(f"`{f}`" for f in ws["folders"])
                         + (f" (started in `{start}`)" if start else ""))
        with lock:
            busy = any(in_scope(st.get("key"), key) and st.get("running", 0) > 0 for st in sessions.values())
        lines.append("Working on a turn." if busy else "Idle.")
        return f"Status for {where}: " + " · ".join(lines)
    return ("Commands (from the owner, applying to this chat or thread): "
            "`/model [<id>|default]`, `/effort [<level>|default]` (a model or effort picked in Buzz's "
            "composer runs just that message; switching runtime/profile moves the chat there), "
            "`/runtime [<name> [<model>]|default]` (claude, codex, hermes, hermes:<profile>, antigravity; "
            "the chat carries on in a fresh session there, given its recent messages), "
            "`/profile [<name>|default]` (switch to a Hermes profile), `/new` (fresh session next message), "
            "`/stop` (stop the running turn), `/status`, "
            "`/workspace [<path>...|off|default]` (folders this chat works in; default: its Canvas's "
            "Buzz workspace folders; a change starts a fresh session).")


def handle_command(msg_id, cmd, args, sid, key, root):
    """Answer the command; msg_id None means the turn goes on to the model."""
    try:
        text = run_command(cmd, args, sid, key, root)
    except Exception as e:
        text = f"/{cmd} failed: {e}"
    log(f"{key}: /{cmd} {' '.join(args)}")
    if msg_id is not None:
        send_client({"jsonrpc": "2.0", "id": msg_id, "result": {"stopReason": "end_turn"}})
    reply(key.split("_", 1)[0], root, text)


# ---------- control socket (buzz-host: Buzz's Stop for remote agents) ----------

def cancel_conversation(channel, root, match_all=False):
    """Cancel the running turn of one conversation: the thread rooted at
    `root`, else the channel's own session (or every session in `channel` when
    `match_all` is True, which covers Solo chats scoped as `channel_root`
    before the relay's solo label arrived). True if one was running."""
    with lock:
        def running(key):
            return [s for s, st in sessions.items() if st.get("key") == key and st.get("running", 0) > 0]
        if match_all:
            targets = [s for s, st in sessions.items() if in_scope(st.get("key"), channel) and st.get("running", 0) > 0]
        else:
            targets = (running(f"{channel}_{root}") if root else []) or running(channel)
    for sid in targets:
        rt, real_sid = split_sid(sid)
        if rt == DEFAULT_TARGET:
            send_adapter({"jsonrpc": "2.0", "method": "session/cancel", "params": {"sessionId": real_sid}})
        else:
            send_adapter({"jsonrpc": "2.0", "method": "session/cancel", "params": {"sessionId": real_sid}}, runtime_id=rt)
    if targets:
        log(f"{channel}{'_' + root if root else ''}: stop from Buzz")
    return bool(targets)


def conversation_sessions(channel, root):
    """The sessions of one conversation, most recently prompted first."""
    key = f"{channel}_{root}" if root else channel
    with lock:
        found = [(st.get("last_used", 0), sid) for sid, st in sessions.items() if st.get("key") == key]
    return [sid for _, sid in sorted(found, reverse=True)]


def conversation_state(channel, root):
    """Buzz's session state for one conversation: compacting, active or idle."""
    sids = conversation_sessions(channel, root)
    with lock:
        states = [sessions.get(sid, {}) for sid in sids]
    if any(st.get("compacting") for st in states):
        return "compacting"
    if any(st.get("running", 0) > 0 for st in states):
        return "active"
    return "idle"


def conversation_state_info(channel, root):
    """State plus session ownership metadata for multi-worker control routing."""
    sids = conversation_sessions(channel, root)
    with lock:
        states = [sessions.get(sid, {}) for sid in sids]
        last_used = max((st.get("last_used", 0) for st in states), default=0)
    if any(st.get("compacting") for st in states):
        st = "compacting"
    elif any(st.get("running", 0) > 0 for st in states):
        st = "active"
    else:
        st = "idle"
    return {"state": st, "hasSession": bool(sids), "lastUsed": last_used}


def fresh_conversation(channel, root):
    """Buzz's New session: the next message starts a fresh session (/new)."""
    if not fresh_dir:
        return {"error": "Fresh sessions need the patched buzz-acp (build-acp.sh)."}
    if conversation_state(channel, root) != "idle":
        return {"error": "Wait for the turn to finish before starting a new session."}
    key = f"{channel}_{root}" if root else channel
    os.makedirs(fresh_dir, exist_ok=True)
    open(os.path.join(fresh_dir, key), "w").close()
    log(f"{key}: new session from Buzz")
    return {"ok": True}


def end_compaction(sid):
    """Clear the compaction and run the prompts buzz-acp sent meanwhile."""
    with lock:
        s = sessions.setdefault(sid, {})
        s["compacting"] = False
        s["running"] = max(0, s.get("running", 1) - 1)
        held = s.pop("held", [])
    for raw in held:
        try:
            rt, out = dispatch_client_line(raw)
            if out is not None:
                if rt == DEFAULT_TARGET:
                    send_adapter_raw(out)
                else:
                    send_adapter_raw(out, runtime_id=rt)
        except Exception as e:
            log(f"sending a held prompt failed: {e}")


def compact_conversation(channel, root):
    """Buzz's Compact: the session's own /compact (or /compress) as a turn of
    this proxy's, which buzz-acp never sees. Resolves when it ends."""
    sids = conversation_sessions(channel, root)
    if not sids:
        return {"error": "No session here yet: it starts with the next message."}
    sid = sids[0]
    rt, real_sid = split_sid(sid)
    with lock:
        s = sessions.setdefault(sid, {})
        if s.get("compacting") or s.get("running", 0) > 0:
            return {"error": "Wait for the turn to finish before compacting."}
        listed = s.get("commands")
        name = (next((c for c in COMPACT_COMMANDS if c in listed), None) if listed is not None
                else (runtime_default_compact(rt) or DEFAULT_COMPACT.get(ADAPTER)))
        if not name:
            return {"error": "This runtime can't compact a session."}
        s["compacting"] = True
        s["running"] = s.get("running", 0) + 1
    key = f"{channel}_{root}" if root else channel
    log(f"{key}: /{name} from Buzz")
    try:
        req = {"sessionId": real_sid, "prompt": [{"type": "text", "text": f"/{name}"}]}
        resp = (proxy_request("session/prompt", req, timeout=COMPACT_TIMEOUT)
                if rt == DEFAULT_TARGET
                else proxy_request("session/prompt", req, timeout=COMPACT_TIMEOUT, runtime_id=rt))
    finally:
        end_compaction(sid)
    if not resp:
        return {"error": "Compaction did not finish in time."}
    if "error" in resp:
        return {"error": (resp["error"] or {}).get("message") or "Compaction failed"}
    stop = (resp.get("result") or {}).get("stopReason")
    return {"compacted": stop != "cancelled", "stopReason": stop}


def control(req):
    op = req.get("op")
    channel = str(req.get("channel", ""))
    root = req.get("root") or None
    if op not in ("cancel", "state", "new", "compact"):
        return {"error": "unknown op"}
    if not UUID_RE.match(channel) or (root and not HEX64_RE.match(str(root))):
        return {"error": "invalid conversation"}
    if op == "cancel":
        return {"cancelled": cancel_conversation(channel, root, match_all=bool(req.get("all")))}
    if op == "state":
        if req.get("detail"):
            return conversation_state_info(channel, root)
        return {"state": conversation_state(channel, root)}
    if op == "new":
        return fresh_conversation(channel, root)
    return compact_conversation(channel, root)


def effective_control_sock():
    if control_dir:
        os.makedirs(control_dir, mode=0o700, exist_ok=True)
        return os.path.join(control_dir, f"{os.getpid()}.sock")
    return control_sock


def cleanup_control_sock():
    global bound_control_sock
    path = bound_control_sock
    bound_control_sock = ""
    if path:
        try:
            os.unlink(path)
        except OSError:
            pass


def serve_control():
    global bound_control_sock
    try:
        sock_path = effective_control_sock()
        if not sock_path:
            return
        try:
            os.unlink(sock_path)
        except OSError:
            pass
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(sock_path)
        os.chmod(sock_path, 0o600)
        bound_control_sock = sock_path
        srv.listen(8)
        while True:
            conn, _ = srv.accept()
            threading.Thread(target=control_conn, args=(conn,), daemon=True).start()
    except Exception as e:
        log(f"control socket failed: {e}")


def control_conn(conn):
    with conn:
        f = conn.makefile("rwb")
        for line in f:
            try:
                reply = control(json.loads(line))
            except Exception as e:
                reply = {"error": str(e)}
            f.write((json.dumps(reply) + "\n").encode())
            f.flush()


