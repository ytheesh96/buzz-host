COMPACT_TIMEOUT = 900
LOCK_TIMEOUT = 5.0
LOCK_STALE = 10.0

lock = threading.RLock()
to_adapter_lock = threading.Lock()
to_client_lock = threading.Lock()
sessions = {}        # sid -> {"options": [...], "key": str|None, "running": int, "runtime": str}
pending_new = {}     # client request id -> {"sid": sid|None, "runtime": str}
pending_prompt = {}  # client request id -> sid
