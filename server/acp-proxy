    r"Event ID: ([0-9a-f]{64})\n.*?^From: .*?hex: ([0-9a-f]{64})\).*?^Content: (.*?)\nTags: ",
    re.M | re.S)
MENTION_RE = re.compile(r"^(?:\s*(?:@\S+|nostr:n(?:pub|profile)1[0-9a-z]+))+\s*")
COMMANDS = {"model", "effort", "new", "stop", "status", "help", "workspace"}
MODEL_KEYS = {"model"}
