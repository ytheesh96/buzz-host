def hermes_home(profile=""):
    return os.path.join(HERMES_ROOT, "profiles", profile) if profile else HERMES_ROOT


def format_target(rt, profile=""):
    rt = str(rt or "").strip().lower()
    prof = str(profile or "").strip()
    if rt == "hermes" and prof and prof.lower() != "default":
        return f"hermes:{prof}"
    return rt


def parse_target(spec):
    """Parse 'claude', 'hermes', 'hermes:default', or 'hermes:<profile>' into
    (runtime, profile, canonical_target), or None when invalid."""
    if not isinstance(spec, str):
        return None
    trimmed = spec.strip()
    if not trimmed:
        return None
    if ":" in trimmed:
        raw_rt, raw_prof = trimmed.split(":", 1)
    else:
        raw_rt, raw_prof = trimmed, ""
    rt = raw_rt.strip().lower()
    prof = raw_prof.strip()
    if rt not in KNOWN_RUNTIMES:
        return None
    if rt != "hermes":
        if prof:
            return None
        return rt, "", rt
    if not prof or prof.lower() == "default":
        return "hermes", "", "hermes"
    if not PROFILE_RE.match(prof):
        return None
    return "hermes", prof, f"hermes:{prof}"


def base_runtime(target_or_adapter):
    parsed = parse_target(target_or_adapter) if isinstance(target_or_adapter, str) else None
    return parsed[0] if parsed else target_or_adapter


def _detect_default_profile():
    if DEFAULT_RUNTIME != "hermes":
        return ""
    explicit = os.environ.get("BUZZ_HOST_HERMES_PROFILE", "").strip()
    if explicit:
        return "" if (explicit.lower() == "default" or not PROFILE_RE.match(explicit)) else explicit
    hh = os.environ.get("HERMES_HOME", "").strip()
    if hh:
        norm = os.path.normpath(os.path.expanduser(hh))
        prefix = os.path.normpath(os.path.join(HERMES_ROOT, "profiles")) + os.sep
        if norm.startswith(prefix):
            rest = norm[len(prefix):]
            if os.sep not in rest and rest.lower() != "default" and PROFILE_RE.match(rest):
                return rest
    return ""


DEFAULT_PROFILE = _detect_default_profile()
DEFAULT_TARGET = format_target(DEFAULT_RUNTIME, DEFAULT_PROFILE) if DEFAULT_RUNTIME in KNOWN_RUNTIMES else DEFAULT_RUNTIME


def runtime_title(rt):
    parsed = parse_target(rt) if isinstance(rt, str) else None
    if parsed:
        base, prof, _ = parsed
        if base == "hermes" and prof:
            return f"Hermes ({prof})"
        return RUNTIME_TITLES.get(base, base)
    return RUNTIME_TITLES.get(rt, rt)


