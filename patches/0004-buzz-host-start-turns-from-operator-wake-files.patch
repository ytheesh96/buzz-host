+/// buzz-host patch: start the operator wakes waiting in `$BUZZ_ACP_WAKE_DIR`
+/// that can run now (see [`host_wake`]). A chat wake waits while its scope has
+/// a turn in flight or queued events, so people's messages go first; an
+/// independent wake runs on the heartbeat path, one at a time, each in a
+/// fresh session. Returns the scopes to show typing in.
+fn dispatch_host_wakes(
+    pool: &mut AgentPool,
+    queue: &mut EventQueue,
+    ctx: &Arc<PromptContext>,
+    heartbeat_in_flight: &mut bool,
+    last_activity: &mut tokio::time::Instant,
+) -> Vec<(scope::SessionScope, ThreadTags)> {
+    let Some(dir) = host_wake::wake_dir() else {
+        return Vec::new();
+    };
+    let mut typing = Vec::new();
+    for wake in host_wake::scan(&dir) {
+        let scope = wake.request.scope();
+        if let Some(scope) = &scope {
+            if queue.is_scope_in_flight(scope)
+                || queue.has_pending_for(scope)
+                || host_wake::is_wake_scope(scope)
+            {
+                continue;
+            }
+        } else if *heartbeat_in_flight {
+            continue;
+        }
+        let Some(mut agent) = pool.try_claim(scope.as_ref()) else {
+            break;
+        };
+        if !host_wake::claim(&wake) {
+            pool.return_agent(agent);
+            continue;
+        }
+        let prompt_text = wake.request.prompt_text();
+        let (control_tx, control_rx) = tokio::sync::oneshot::channel::<ControlSignal>();
+        let turn_id = Uuid::new_v4().to_string();
+        let task_turn_id = turn_id.clone();
+        let agent_index = agent.index;
+        let result_tx = pool.result_tx();
+        let ctx_clone = Arc::clone(ctx);
+        let batch = match &scope {
+            Some(scope) => {
+                queue.begin_host_wake(scope);
+                let owner_generation = pool.record_scope_owner(scope.clone(), agent.index);
+                agent
+                    .state
+                    .set_scope_owner_generation(scope.clone(), owner_generation);
+                Some(queue::FlushBatch {
+                    channel_id: scope.channel_id(),
+                    scope: scope.clone(),
+                    events: Vec::new(),
+                    cancelled_events: Vec::new(),
+                    cancel_reason: None,
+                })
+            }
+            None => {
+                agent.state.invalidate(&PromptSource::Heartbeat);
+                *heartbeat_in_flight = true;
+                None
+            }
+        };
+        host_wake::register(&turn_id, &wake.request);
+        let abort_handle = pool.join_set.spawn(async move {
+            pool::run_prompt_task(
+                agent,
+                batch,
+                Some(prompt_text),
+                ctx_clone,
+                result_tx,
+                Some(control_rx),
+                task_turn_id,
+                Default::default(),
+            )
+            .await;
+        });
+        pool.task_map_mut().insert(
+            abort_handle.id(),
+            pool::TaskMeta {
+                agent_index,
+                channel_id: scope.as_ref().map(scope::SessionScope::channel_id),
+                scope: scope.clone(),
+                turn_id,
+                recoverable_batch: None,
+                control_tx: Some(control_tx),
+                steer_tx: None,
+                successful_steer_deliveries: HashSet::new(),
+            },
+        );
+        *last_activity = tokio::time::Instant::now();
+        if let Some(scope) = scope {
+            let thread_tags = ThreadTags {
+                root_event_id: scope.root_event_id().map(str::to_string),
+                parent_event_id: scope.root_event_id().map(str::to_string),
+                ..Default::default()
+            };
+            typing.push((scope, thread_tags));
+        }
+    }
+    typing
+}
