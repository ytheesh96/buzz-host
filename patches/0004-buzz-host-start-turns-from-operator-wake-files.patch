--- a/crates/buzz-acp/src/queue.rs
+++ b/crates/buzz-acp/src/queue.rs
@@ -623,6 +623,24 @@ impl EventQueue {
         })
     }
 
+    /// buzz-host patch: mark `scope` in flight for an operator wake turn,
+    /// which has no queued events. `mark_complete` releases it as usual.
+    pub fn begin_host_wake(&mut self, scope: &SessionScope) {
+        self.in_flight_scopes.insert(scope.clone());
+        self.in_flight_deadlines
+            .insert(scope.clone(), Instant::now() + self.in_flight_deadline);
+        self.in_flight_batch_sizes.insert(scope.clone(), 0);
+    }
+
+    /// buzz-host patch: whether `scope` has queued or cancelled events
+    /// waiting, which an operator wake lets go first.
+    pub fn has_pending_for(&self, scope: &SessionScope) -> bool {
+        self.queues
+            .get(scope)
+            .is_some_and(|queue| !queue.is_empty())
+            || self.cancelled_batches.contains_key(scope)
+    }
+
