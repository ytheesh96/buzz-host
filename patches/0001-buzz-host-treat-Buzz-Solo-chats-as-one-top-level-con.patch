diff --git a/crates/buzz-acp/src/scope.rs b/crates/buzz-acp/src/scope.rs
index a0dd2176f..ab0a6a672 100644
--- a/crates/buzz-acp/src/scope.rs
+++ b/crates/buzz-acp/src/scope.rs
@@ -25,6 +25,42 @@ use uuid::Uuid;
 
 use crate::queue::{reply_thread, ResolvedEdit};
 
+/// NIP-CL channel label Buzz puts on a Solo chat.
+pub const SOLO_LABEL: &str = "buzz.solo";
+
+/// Channels whose kind:39000 metadata carries [`SOLO_LABEL`], as last seen.
+///
+/// Buzz runs a Solo chat as one top-level conversation, so it is
+/// conversation-scoped (like a DM) under every [`SessionPolicy`], while its
+/// events still need a mention like any channel's.
+static SOLO_CHANNELS: std::sync::LazyLock<std::sync::RwLock<std::collections::HashSet<Uuid>>> =
+    std::sync::LazyLock::new(Default::default);
+
+/// Record whether `channel_id`'s metadata tags label it a Solo chat.
+pub fn record_channel_labels(channel_id: Uuid, tags: &[serde_json::Value]) {
+    let solo = tags.iter().any(|tag| {
+        tag.as_array().is_some_and(|arr| {
+            arr.first().and_then(|v| v.as_str()) == Some("t")
+                && arr.get(1).and_then(|v| v.as_str()) == Some(SOLO_LABEL)
+        })
+    });
+    if let Ok(mut set) = SOLO_CHANNELS.write() {
+        if solo {
+            set.insert(channel_id);
+        } else {
+            set.remove(&channel_id);
+        }
+    }
+}
+
+/// True when the channel was last seen labelled a Solo chat.
+pub fn is_solo_channel(channel_id: Uuid) -> bool {
+    SOLO_CHANNELS
+        .read()
+        .map(|set| set.contains(&channel_id))
+        .unwrap_or(false)
+}
+
 /// Operator policy controlling how ACP provider sessions are scoped.
 ///
 /// Selected via `--session-policy` / `BUZZ_ACP_SESSION_POLICY`. Defaults to
@@ -146,7 +182,7 @@ impl SessionScope {
         event: &Event,
         edit: Option<&ResolvedEdit>,
     ) -> Self {
-        if is_dm || policy == SessionPolicy::Channel {
+        if is_dm || policy == SessionPolicy::Channel || is_solo_channel(channel_id) {
             return Self::Conversation { channel_id };
         }
 
@@ -220,6 +256,25 @@ mod tests {
         }
     }
 
+    #[test]
+    fn solo_chat_is_conversation_scoped_under_thread_policy() {
+        let ch = Uuid::new_v4();
+        let labels = vec![
+            serde_json::json!(["d", ch.to_string()]),
+            serde_json::json!(["t", "private"]),
+            serde_json::json!(["t", SOLO_LABEL]),
+        ];
+        record_channel_labels(ch, &labels);
+        let ev = event_with_tags(vec![]);
+        assert_eq!(
+            SessionScope::derive(SessionPolicy::Thread, ch, false, &ev),
+            SessionScope::Conversation { channel_id: ch }
+        );
+        // Converted back to an ordinary channel: threads again.
+        record_channel_labels(ch, &labels[..2]);
+        assert!(SessionScope::derive(SessionPolicy::Thread, ch, false, &ev).is_thread());
+    }
+
