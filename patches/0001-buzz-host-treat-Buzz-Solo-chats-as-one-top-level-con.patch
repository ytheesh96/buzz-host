+/// buzz-host patch: a top-level mention in a Solo chat (`buzz.solo` label) is
+/// answered at the top level, as Buzz's own agents answer Solo chats.
+fn append_solo_reply_instruction(s: &mut String) {
+    s.push_str(
+        "\nIMPORTANT: This channel is a Solo chat: one top-level conversation. \
+         For ordinary replies in this turn, send `buzz messages send` WITHOUT \
+         `--reply-to`, so your reply stays at the top level. Reply in a thread \
+         only if the human explicitly asks for one.",
+    );
+}
+
 /// Decide whether a turn is human-facing for reply-anchor purposes.
 ///
 /// A turn is human-facing when the triggering sender is a human, OR a human
@@ -2064,7 +2075,11 @@ fn format_context_hints(
             "\nHint: Use `buzz messages get --channel <UUID>` for recent messages if needed.",
         );
         if let Some(event_id) = reply_anchor {
-            append_new_thread_reply_instruction(&mut s, event_id);
+            if crate::scope::is_solo_channel(channel_id) {
+                append_solo_reply_instruction(&mut s);
+            } else {
+                append_new_thread_reply_instruction(&mut s, event_id);
+            }
         }
         crate::prompt_framing::semantic_section("context", &s)
     }
